# Copy to .env for local development. Never commit .env.
# See docs/DECISIONS.md #1 for why this is a real Supabase dev project rather than local Docker.
# Get these from the Supabase dashboard: Connect -> ORMs -> Prisma.

# Postgres — transaction-mode pooler (port 6543, pgbouncer=true), used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Postgres — session-mode pooler (port 5432), used by Prisma Migrate.
# Not the true "direct connection" host (db.<project-ref>.supabase.co) — that one is IPv6-only
# unless the paid IPv4 add-on is purchased. The session pooler is Supabase's own recommended
# stand-in for Prisma's directUrl.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

NODE_ENV="development"

# Auth.js v5 — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Vercel Cron -> POST /api/cron/drain auth (Spec.md §9.1). Unset locally; Vercel sets this and
# sends it as a bearer token automatically once the cron entry exists (module 00 session 5).
# REQUIRED in production. Without it the cron endpoints refuse with 503 rather than running —
# they used to run for anybody, which is why this is no longer optional. `openssl rand -hex 32`.
CRON_SECRET=

# Supabase Storage (module 00 session 4). SUPABASE_URL is https://<project-ref>.supabase.co.
# SUPABASE_SERVICE_ROLE_KEY is Project Settings -> API -> service_role secret key — server-side
# only, never expose to the client. Bucket is created automatically (idempotent) by
# scripts/ensure-storage-bucket.ts if it doesn't already exist.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET="aies-files"  # override only if you need a non-default bucket name
