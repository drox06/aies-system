# Copy to .env for local development. Never commit .env.
# See docs/DEPLOYMENT.md (written in module 00 session 5) for Supabase pooled vs. direct URLs.

# Postgres — pooled connection string, used by the app at runtime
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aies?schema=public"
# Postgres — direct (non-pooled) connection string, used by Prisma Migrate
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aies?schema=public"

NODE_ENV="development"

# Filled in during module 00 session 2 (Auth.js)
# AUTH_SECRET=
# AUTH_URL="http://localhost:3000"

# Filled in during module 00 session 4/5 (Supabase Storage)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
