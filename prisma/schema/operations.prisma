// Module 04 — Operations and Projects (specs/04-operations-projects.md §3).
//
// §2 is firm about vocabulary, and it is not a style preference: "A **Ticket** is the unit of
// operational work generated from a PO… This is the company's own term — use it in the UI, the
// code, and the numbering. **Do not rename it to 'job order'.**"
//
// §1 draws two things that shape these models more than anything else:
//
//  1. **The delivery lane is genuinely separate.** It has its own mobilization, its own
//     demobilization and its own retry loops. "It is not a step inside a project — it is a ticket
//     type. Model it as such." So a delivery ticket has no `projectId`, and that is a rule rather
//     than an omission.
//  2. **Four gates**, two before mobilization (cash advance, material request) and two after
//     execution (QA, warranty). Session 1 carries the columns they move; the gates themselves are
//     later sessions, and the columns are here so those sessions need no migration.

/// The unit of operational work (§2, §3).
///
/// Generated from a sales order — but never *silently*. §4: "Operations **confirms or edits** the
/// proposed set before generation. Do not auto-generate silently — one PO can legitimately be one
/// ticket or eight, and only a human knows which." So nothing in this build creates a Ticket from an
/// event; `sales_order.created` produces a proposal for somebody to review.
model Ticket {
  id     String @id @default(cuid())
  /// AIESTKT-{YY}{####}, seeded since module 00.
  number String @unique

  /// Where it came from. All nullable: §4 allows a standalone ticket with no PO at all — "warranty
  /// callback, emergency, goodwill visit" — and those are real work that still needs scheduling.
  salesOrderId String?
  customerPOId String?
  accountId    String
  siteId       String?

  /// new_project | installation | after_sales | delivery (§3). The type is the route: §1's four
  /// lanes hang off it, and a delivery ticket runs an entirely different one.
  type     String
  /// For after_sales: warranty | corrective | preventive | calibration | troubleshooting | training.
  subType  String?
  /// low | normal | high | emergency
  priority String  @default("normal")

  title               String
  scopeOfWork         String
  specialInstructions String?

  /// generated | cash_advance_pending | material_pending | ready_to_mobilize | mobilized |
  /// in_progress | qa | tc | for_closeout | completed | cancelled | on_hold (§3).
  ///
  /// The full vocabulary from the start, though session 1 only reaches `generated`. The same choice
  /// `CustomerPO.status` made: a column with its whole vocabulary lets the sessions that add the
  /// gates add behaviour without a migration.
  status String @default("generated")

  /// Null for delivery tickets, always (§2). Several tickets can roll up to one project.
  projectId String?

  raisedById String
  raisedAt   DateTime @default(now())

  assignedLeadId  String?
  /// Plain ids, not a join: read whole, never queried across. Same choice as `productLines`.
  assignedUserIds String[] @default([])

  requiredByDate DateTime?
  holdReason     String?

  /// §1's first gate. A boolean rather than a status because the *question* is asked of every
  /// ticket type — "CASH ADVANCE REQUIRED? (Y/N)" — and the answer being "no" is a decision worth
  /// recording, not an absence.
  cashAdvanceRequired   Boolean @default(false)
  /// §1's second gate: required | not_applicable | requested | issued | partial.
  materialRequestStatus String  @default("not_applicable")

  /// §4: a standalone ticket is "`billable = false` by default and a required justification".
  /// Nobody is invoiced for a goodwill visit, and the reason it happened is the whole record of it.
  billable      Boolean @default(true)
  justification String?

  customFields Json @default("{}")

  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  account       CustomerAccount        @relation(fields: [accountId], references: [id])
  site          Site?                  @relation(fields: [siteId], references: [id])
  salesOrder    SalesOrder?            @relation(fields: [salesOrderId], references: [id])
  customerPO    CustomerPO?            @relation(fields: [customerPOId], references: [id])
  project       Project?               @relation(fields: [projectId], references: [id])
  lines         TicketSalesOrderLine[]
  cashAdvances  CashAdvance[]
  inspections   SiteInspection[]
  methodologies Methodology[]

  @@index([accountId, status])
  @@index([salesOrderId])
  @@index([status, requiredByDate])
  @@index([assignedLeadId, status])
}

/// Which sales order lines a ticket covers (§4).
///
/// **Not in §3's model sketch, and required by §4**: "Each ticket links back to the specific sales
/// order lines it covers, so fulfilment counters and billing milestones stay accurate." Without it,
/// a sales order that generated three tickets cannot say which one owes which line — and module 05
/// cannot bill a milestone, because a milestone is defined by the lines it covers.
///
/// A join table rather than an id array on `Ticket`, because this is the one relation in the module
/// that other modules will query *across* — "which ticket covers this line" is module 05's question,
/// and an array cannot answer it with an index.
model TicketSalesOrderLine {
  id               String @id @default(cuid())
  ticketId         String
  /// Plain id: `SalesOrderLine` is module 03's, and the modules stay uncoupled at the schema level
  /// the same way `PrincipalProspect.supplierId` did until module 03 landed. It becomes a foreign
  /// key when something needs the database to enforce it.
  salesOrderLineId String

  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// One ticket covers a line once. Two tickets may legitimately cover the same line — a supply and
  /// a separate commissioning visit — so the uniqueness is per pair, not per line.
  @@unique([ticketId, salesOrderLineId])
  @@index([salesOrderLineId])
}

/// The container for field execution (§2, §3).
///
/// §2: "A **Project** exists only for `new_project`, `installation`, and `after_sales` tickets that
/// involve field execution… A single PO can generate several tickets, and several tickets can roll
/// up to one project." So a project is created *with* the first execution ticket of an order rather
/// than per ticket — three visits to the same site for the same order are one project with one
/// schedule, one team and one close-out pack.
///
/// A delivery ticket never has one.
model Project {
  id   String @id @default(cuid())
  /// AIESPRJ-{YY}{####}.
  code String @unique

  salesOrderId String?
  accountId    String
  siteId       String?

  name        String
  description String?
  scopeOfWork String

  /// planning | site_inspection | methodology | mobilising | in_progress | qa | tc | for_closeout |
  /// closed | on_hold | cancelled (§3). Session 1 reaches `planning`; §6's site inspection and
  /// methodology gates move it from there.
  status String @default("planning")

  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?

  projectManagerId String?
  teamMemberIds    String[] @default([])

  /// Permission-gated on the way out, exactly as the quotation's and the sales order's are
  /// (Spec.md §4.3). §19: "Technicians… see scope, site data, and their own cash advances — **never
  /// contract value or margin**."
  contractValue Decimal @default(0) @db.Decimal(14, 2)
  budgetCost    Decimal @default(0) @db.Decimal(14, 2)
  actualCost    Decimal @default(0) @db.Decimal(14, 2)

  progressPct Int     @default(0)
  riskLevel   String  @default("low")
  holdReason  String?

  customFields Json @default("{}")

  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  account       CustomerAccount  @relation(fields: [accountId], references: [id])
  site          Site?            @relation(fields: [siteId], references: [id])
  tickets       Ticket[]
  cashAdvances  CashAdvance[]
  inspections   SiteInspection[]
  methodologies Methodology[]

  @@index([accountId, status])
  @@index([status, plannedStart])
}

/// §5's Gate 1 — the cash advance that stands between a ticket and a crew leaving the yard.
///
/// §5 opens by naming why it is modelled at all: "This is a real constraint in the flowchart and is
/// **currently invisible to everyone until a technician can't board a bus**. Make it a blocking,
/// tracked step."
///
/// So the money, the approval, the release and the liquidation are one record with one status, and
/// the ticket's `cashAdvanceRequired` flag is what turns it into a gate.
model CashAdvance {
  id     String @id @default(cuid())
  /// AIESCA-{YY}{####}, seeded since module 00.
  number String @unique

  /// One of the two, usually the ticket. §5 allows a project-level advance for work that spans
  /// several tickets — "covering the whole crew on one advance".
  ticketId  String?
  projectId String?

  requestedById String
  /// The crew this covers. §5: "The request comes from the assigned team leader or the Operations
  /// Manager, **covering the whole crew on one advance**" — so five technicians on one job produce
  /// one advance, not five, and the liquidation that follows is one reconciliation.
  requestedFor  String[] @default([])

  purpose   String
  /// [{ category, description, amount }] — §5's eight categories, in a shape the screen edits as a
  /// table. Json rather than a line model because nothing queries across a breakdown line: it is
  /// read whole with its advance, and the liquidation is what gets reconciled against it.
  breakdown Json   @default("[]")

  amountRequested Decimal  @db.Decimal(14, 2)
  amountApproved  Decimal? @db.Decimal(14, 2)
  currency        String   @default("PHP")

  /// When the crew needs the money in hand — not when they leave. §5's whole point is that the two
  /// are different and nobody currently sees the gap.
  neededBy DateTime

  /// draft | pending_approval | approved | rejected | released | liquidated |
  /// partially_liquidated | overdue_liquidation | extended (§5).
  status String @default("draft")

  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  /// [{ requestedAt, requestedById, reason, newDueAt, approvedById, approvedAt }] (§5).
  ///
  /// An **append-only log**, never a silent edit of `liquidationDueAt`. §5 is explicit about why:
  /// "an indefinitely extendable deadline becomes no deadline unless the extension itself is
  /// visible and counted." The register reads this to tell *formally extended, and why* apart from
  /// *simply late*.
  extensions Json @default("[]")

  releasedById  String?
  releasedAt    DateTime?
  /// cash | bank_transfer | gcash | petty_cash (§5).
  releaseMethod String?

  /// §5: "Liquidation is due **3 working days after demobilization**, counted on the working
  /// calendar." Demobilization is §8's and does not exist, so this is set at release from the
  /// ticket's required-by date — see `liquidationDueFrom` in cash-advance-rules.ts, which §8 will
  /// call again with the real date.
  liquidationDueAt DateTime?
  liquidatedAt     DateTime?

  amountLiquidated Decimal? @db.Decimal(14, 2)
  amountReturned   Decimal? @db.Decimal(14, 2)
  amountReimbursed Decimal? @db.Decimal(14, 2)

  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  ticket       Ticket?                  @relation(fields: [ticketId], references: [id])
  project      Project?                 @relation(fields: [projectId], references: [id])
  liquidations CashAdvanceLiquidation[]

  @@index([status, liquidationDueAt])
  @@index([ticketId])
  @@index([requestedById, status])
}

/// The reconciliation of an advance (§5).
///
/// Its own model rather than columns on `CashAdvance` because §5 gives it a review cycle of its own
/// — submitted, under review, approved or rejected — and a rejected liquidation is resubmitted
/// rather than overwritten. Two attempts at reconciling one advance are two records, and the
/// register needs to be able to show both.
model CashAdvanceLiquidation {
  id            String   @id @default(cuid())
  cashAdvanceId String
  submittedById String
  submittedAt   DateTime @default(now())

  /// [{ date, category, description, amount, receiptFileId, hasOfficialReceipt }] (§5).
  ///
  /// `hasOfficialReceipt` is separate from having *a* receipt on purpose: a BIR official receipt is
  /// what makes a cost deductible, and a bus ticket is not one. Module 05 needs to tell them apart
  /// when these post as project costs.
  lines Json @default("[]")

  totalSpent          Decimal @default(0) @db.Decimal(14, 2)
  balanceReturned     Decimal @default(0) @db.Decimal(14, 2)
  balanceReimbursable Decimal @default(0) @db.Decimal(14, 2)

  /// draft | submitted | under_review | approved | rejected (§5).
  status String @default("submitted")

  reviewedById String?
  reviewedAt   DateTime?
  remarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashAdvance CashAdvance @relation(fields: [cashAdvanceId], references: [id], onDelete: Cascade)

  @@index([cashAdvanceId, submittedAt])
  @@index([status])
}

/// §6.1's site inspection — the visit itself, as distinct from the ask.
///
/// §6 opens by scoping it: "Only `new_project` tickets take this branch, per the flowchart." But
/// the section then widens it in a sentence that matters more than the sketch above it: "This is
/// **also the sub-flow module 01 calls** when sales requests a pre-quotation inspection — same
/// record type, raised from an inquiry instead of a ticket."
///
/// So §6.1's field list (`ticketId, projectId?, siteId`) is incomplete by its own prose, and this
/// model carries `inquiryId` and `inspectionRequestId` as well. All four origins are nullable
/// because an inspection legitimately arrives by two routes:
///
///  1. **From a ticket**, when a new project needs surveying before work is planned.
///  2. **From an inquiry**, when sales cannot price the job without somebody looking at the site —
///     specs/01-crm-inquiry.md §5, whose `InspectionRequest` is the *request* and this is the
///     *visit*. crm.prisma already anticipated this: "When module 04 lands it consumes
///     `inspection.requested` and this becomes the request of record with the field task
///     alongside it."
///
/// Keeping them one model rather than two is the spec's instruction and also the useful choice: the
/// findings, the photographs and the scope-change flag are identical whichever way the visit was
/// asked for, and a company that inspects a site pre-quotation and again pre-mobilisation wants both
/// visits in one place.
model SiteInspection {
  id     String @id @default(cuid())
  /// AIESSIR-{YY}{####} — site inspection report.
  number String @unique

  /// Origins. See the model comment: at least one is always set, enforced by the service rather
  /// than by a check constraint, so the error is a sentence instead of a Postgres violation.
  ticketId            String?
  projectId           String?
  inquiryId           String?
  inspectionRequestId String? @unique
  siteId              String?

  inspectedAt    DateTime?
  /// Plain ids. Several people attend a survey and the list is read whole, never queried across —
  /// the same choice `Ticket.assignedUserIds` made.
  inspectedByIds String[]  @default([])

  /// §6.1's free-form record of what was found and what is already there.
  findings           String?
  existingConditions Json    @default("{}")

  /// [{ label, value, unit }] — §6.1's measurements. Json because no two surveys measure the same
  /// things, and a column per dimension would be a migration per site type.
  measurements Json     @default("[]")
  /// Equipment tag numbers seen on site. specs/01-crm-inquiry.md §5 names a tag list as one of the
  /// "required outputs" precisely because coming back for it costs a second visit.
  tagNumbers   String[] @default([])

  accessConstraints  String?
  permitsRequired    String[] @default([])
  hazards            String[] @default([])
  /// { power, air, water, crane, scaffolding } — §6.1's list, as booleans with a note.
  utilitiesAvailable Json     @default("{}")

  /// FileObject ids from module 00 storage.
  photoFileIds  String[] @default([])
  sketchFileIds String[] @default([])

  /// scheduled | completed | approved (§6.1).
  status String @default("scheduled")

  /// §6.1: "**If `scopeChangeIdentified` is true, emit `scope_change.identified`.** … Discovering at
  /// inspection that the job is bigger than quoted is normal; discovering it *after* mobilization is
  /// expensive. This link is one of the highest-value things the platform does."
  ///
  /// A boolean and not an inference. Nothing can reliably derive "this is bigger than we quoted"
  /// from findings text, and a guess here either cries wolf or stays silent on the one that mattered.
  scopeChangeIdentified Boolean @default(false)
  scopeChangeNotes      String?

  /// Set when the event has actually been emitted, so re-saving an inspection that already reported
  /// a scope change does not tell sales twice. Nullable rather than a boolean: the timestamp is the
  /// answer to "when did sales find out", which is the question asked afterwards.
  scopeChangeReportedAt DateTime?

  requestedById String?
  scheduledFor  DateTime?
  completedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?

  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  ticket  Ticket?  @relation(fields: [ticketId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([status, scheduledFor])
  @@index([ticketId])
  @@index([inquiryId])
}

/// §6.2's method statement — how the work will actually be done.
///
/// §6.2: "It is a **controlled document** (module 07), not a free-text field." Module 07 does not
/// exist, so `documentId` is nullable and waits for it. Everything else is here, because the part
/// that matters commercially is not the filing — it is the sentence below.
///
/// §6.2: "**The client approves the methodology before work starts. Always.**" And the reason the
/// dates are modelled as carefully as the content: "Client methodology approval is a common and
/// invisible source of schedule slip, and AIES is usually blamed for delays it did not cause. **A
/// dated submission record changes that conversation.**"
model Methodology {
  id     String @id @default(cuid())
  /// AIESMTH-{YY}{####}, seeded since module 00.
  number String

  projectId String?
  ticketId  String?

  title    String
  /// R0, R1, … A rejection by the client creates the next one; see `parentMethodologyId`.
  revision Int    @default(0)

  /// The root of the revision chain, null on R0 — the same shape as Quotation's, and for the same
  /// reason: §6.2 calls the chain "the evidence of what was agreed", and a linked list makes
  /// "show me every revision" a recursive walk.
  parentMethodologyId String?

  scopeSummary   String
  /// [{ step, description, durationHours, crew }] — §6.2's "ordered steps with duration and crew".
  sequenceOfWork Json   @default("[]")
  /// [{ role, count, notes }].
  manpowerPlan   Json   @default("[]")

  /// §6.2: these two "**pre-populate the material request** in §7. Nobody should type the same list
  /// twice." §7 does not exist yet; the shapes are chosen so it can read them without a migration.
  toolsRequired     String[] @default([])
  /// [{ description, quantity, unit }].
  materialsRequired Json     @default("[]")

  safetyPlan String?
  /// The job safety analysis, as an uploaded FileObject.
  jsaFileId  String?

  permitsRequired             String[] @default([])
  environmentalConsiderations String?

  durationDays       Int?
  mobilizationPlan   String?
  demobilizationPlan String?
  contingencyPlan    String?

  /// draft | internal_review | approved | submitted_to_client | client_approved | client_rejected |
  /// superseded (§6.2).
  status String @default("draft")

  preparedById String
  reviewedById String?
  approvedById String?
  approvedAt   DateTime?

  /// §6.2's turnaround, and the whole point of dating it: the gap between these two is the
  /// customer's, and without a record of it the delay is remembered as AIES's.
  submittedToClientAt  DateTime?
  clientApprovedAt     DateTime?
  /// The client's own signed approval. §6.2 gates mobilization on this **as well as** the status —
  /// a status somebody set and a document the client signed are not the same claim.
  clientApprovalFileId String?
  clientRejectionNotes String?

  /// §6.2: "defaults to `true` and the flag exists only so a rare exception can be recorded, not as
  /// a routine setting." Turning it off is an act with a reason attached, not a checkbox.
  clientApprovalRequired Boolean @default(true)
  /// Why the exception was made, when it was. Null whenever `clientApprovalRequired` is true.
  clientApprovalWaiver   String?

  /// Module 07's controlled document. Null until module 07 exists.
  documentId String?

  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  project Project? @relation(fields: [projectId], references: [id])
  ticket  Ticket?  @relation(fields: [ticketId], references: [id])

  parent   Methodology?  @relation("MethodologyRevisions", fields: [parentMethodologyId], references: [id])
  children Methodology[] @relation("MethodologyRevisions")

  /// One row per revision of a number, exactly like Quotation's.
  @@unique([number, revision])
  @@index([projectId, status])
  @@index([ticketId])
  @@index([status, submittedToClientAt])
}
