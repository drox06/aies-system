// specs/00-foundation.md §7.3. Only the in-app channel actually delivers anything this session —
// no email provider is configured yet (see docs/DECISIONS.md). Email/digest preferences are
// tracked and an email job is enqueued when requested, so the plumbing is real; nothing consumes
// the "notify_email" queue yet, which dead-letters visibly rather than silently dropping mail —
// exactly the "make failure loud" principle Spec.md §3.3 asks for.
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  type        String
  title       String
  body        String?
  entityType  String?
  entityId    String?
  // Coalesced occurrences folded into this one row (specs/00-foundation.md §7.3: "Ten comments
  // on one quote in five minutes is one notification").
  count       Int       @default(1)
  readAt      DateTime?

  /// Held by §7's quiet hours until the morning, and **never dropped**.
  ///
  /// The company's decision of 2026-08-20, and the reason the column exists rather than a `return`
  /// inside `notify()`: *"a system that pings technicians at midnight gets muted, and then the
  /// important message is missed too"* — but a notification thrown away at 23:00 is the same
  /// message missed, just silently. It is written now, hidden until `heldUntil`, and released by the
  /// drain.
  heldUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId, readAt, createdAt])
  @@index([heldUntil])
}

model NotificationPreference {
  id     String  @id @default(cuid())
  userId String
  type   String
  inApp  Boolean @default(true)
  email  Boolean @default(true)
  digest Boolean @default(false)

  @@unique([userId, type])
}

/// specs/06-collaboration.md §7's quiet hours and digest time.
///
/// ## Why it lives in module 00's file rather than module 06's
///
/// `notify()` reads it on every send, and `notify()` is module 00's. Module 06 owns the *screen* and
/// the rule, as §7 says — *"uses module 00's notify service"* — but the thing the service must
/// consult belongs beside the service. A row exists only once somebody changes something: the
/// defaults are in code so that eight of nine people need no row at all.
model NotificationSchedule {
  id     String @id @default(cuid())
  userId String @unique

  /// Minutes past midnight, Manila. §7's default is 18:00–07:00, held in code rather than here.
  quietFromMinutes Int?
  quietToMinutes   Int?
  /// Off entirely, for somebody who would rather be told at once whatever the hour.
  quietHoursOn     Boolean @default(true)

  /// When the morning digest is sent, minutes past midnight, Manila. §7: "configurable".
  digestAtMinutes Int @default(420)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One subscribed device (browser + install), §7's actual answer to "make the phone ring".
///
/// A user can hold several — a phone and a desktop are two different push endpoints, and neither
/// should be lost when the other is added. `endpoint` is unique across the whole table, not just
/// per user, because the push service hands out one endpoint per install and it can never belong
/// to two people at once.
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  /// The push service's URL for this device. Opaque, and the thing `web-push` actually posts to.
  endpoint String @unique

  /// The two keys `PushManager.subscribe()` returns alongside the endpoint — together they let the
  /// server encrypt a payload only this device's browser can decrypt. Both required; a subscription
  /// missing either is not one the browser ever actually produced.
  p256dh String
  auth   String

  /// What device this was, for the settings screen — "iPhone — Safari" reads better than an id.
  userAgent String?

  createdAt  DateTime @default(now())
  /// Bumped on every successful send. A subscription that stops updating is one worth asking the
  /// push service about before it silently goes stale.
  lastSeenAt DateTime @default(now())

  @@index([userId])
}
