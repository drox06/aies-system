// Module 01 — CRM. specs/01-crm-inquiry.md §2.
//
// §1: "Accounts are industrial: a water district, a power plant, a food manufacturer. Each has
// plants, each plant has equipment, and the same account may run several unrelated inquiries at
// once through different engineers. Model the hierarchy properly." So Account → Site → Contact are
// real relations with real foreign keys, not loose id columns.
//
// References to a *user* stay plain string ids with no relation, matching AuditLog.actorId and
// Comment.authorId: the person who owns an account can themselves be deleted, and a foreign key
// would either block that or cascade away the ownership record.
//
// Status fields are String rather than Prisma enums, consistent with every model in module 00.
// Adding a value to a Postgres enum is a migration; these lists are business vocabulary that will
// move, and the allowed values are enforced by Zod at the service boundary where the error message
// can actually be useful.

model CustomerAccount {
  id        String  @id @default(cuid())
  // ACC-{####} from the numbering service (§2). Permanent: the counter has no year segment.
  code      String  @unique
  name      String
  legalName String?
  tin       String?

  /// §3.2 of module 05: withholding is **per account, because it varies**.
  ///
  /// Some AIES customers withhold expanded withholding tax and issue a BIR 2307; some do not. A
  /// single company-wide setting would either surprise finance with less money than the statement
  /// said, or show a deduction that never happens.
  ///
  /// `ewtRate` is a percentage to four places, defaulting to the 2% ordinary rate for services. It
  /// is a per-account override precisely because a government agency withholds differently and also
  /// withholds VAT — §3.2 asks for the override rather than an assumption.
  withholdsEWT Boolean @default(false)
  ewtRate      Decimal @default(2) @db.Decimal(7, 4)
  /// Government agencies withhold at different rates and also withhold VAT. Flagged rather than
  /// inferred from the name, because "Corporation" in a name proves nothing either way.
  isGovernment Boolean @default(false)
  industry     String?
  // customer | prospect | both
  accountType  String  @default("prospect")
  website      String?
  phone        String?
  email        String?

  // Json rather than columns: Philippine addresses do not decompose cleanly into the usual
  // fields (barangay, subdivision, building), and every downstream consumer — PDF headers,
  // delivery notes — wants the whole block, not its parts.
  billingAddress  Json @default("{}")
  shippingAddress Json @default("{}")

  // Plain id, not a relation: PaymentTerms is owned by module 05 and does not exist yet.
  paymentTermsId String?
  // Decimal, never Float. Money compared or summed as binary floating point is how you get a
  // credit limit that is off by a centavo and a customer who disputes it.
  creditLimit    Decimal? @db.Decimal(14, 2)
  currency       String   @default("PHP")

  ownerId String
  // active | dormant | blacklisted
  status  String @default("active")

  // Set only when the *nightly sweep* moved this account to dormant, never when a person did.
  //
  // The distinction is what makes the sweep safe to reverse. A customer the company deliberately
  // parked should stay parked when an order finally arrives; one the system parked because no PO
  // had come in for 500 days should wake up the moment one does. Without this column those two are
  // indistinguishable and the sweep would have to either never undo itself or undo somebody else's
  // decision. See DORMANT_WITHOUT_PO_DAYS in pipeline-rules.ts.
  autoDormantAt DateTime?

  // §2: "for group companies". A water district holding company and its districts.
  parentAccountId String?

  customFields Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Spec.md §10: soft delete with deletedAt AND deletedBy.
  deletedAt DateTime?
  deletedBy String?

  parent               CustomerAccount?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children             CustomerAccount[]     @relation("AccountHierarchy")
  sites                Site[]
  contacts             Contact[]
  accreditations       AccreditationRecord[]
  inquiries            Inquiry[]
  quotations           Quotation[]
  customerPOs          CustomerPO[]
  salesOrders          SalesOrder[]
  tickets              Ticket[]
  projects             Project[]
  equipment            Equipment[]
  warrantyClaims       WarrantyClaim[]
  maintenanceContracts MaintenanceContract[]

  @@index([ownerId, status])
  @@index([status, name])
  // Partial-index equivalent for the common "live accounts only" scan.
  @@index([deletedAt])
}

// A plant or facility belonging to an account.
model Site {
  id        String @id @default(cuid())
  accountId String
  name      String
  address   Json   @default("{}")
  geo       Json?

  // §2's own emphasis: gate pass, PPE, induction requirements. This is the field that stops a
  // technician arriving at a refinery without the right induction and losing a day.
  accessNotes String?

  // The site's main contact. Nullable and deliberately NOT a relation with a foreign key —
  // Contact.siteId already points the other way, and a mandatory cycle between the two would make
  // both impossible to create first.
  contactId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  account     CustomerAccount     @relation(fields: [accountId], references: [id])
  contacts    Contact[]
  inquiries   Inquiry[]
  tickets     Ticket[]
  projects    Project[]
  inspections InspectionRequest[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@index([accountId, deletedAt])
}

model Contact {
  id         String  @id @default(cuid())
  accountId  String
  siteId     String?
  firstName  String
  lastName   String
  position   String?
  department String?

  email  String?
  mobile String?
  phone  String?

  isPrimary       Boolean @default(false)
  // §1: AIES sells through relationships, so knowing who can actually say yes is load-bearing,
  // not a nice-to-have CRM field.
  isDecisionMaker Boolean @default(false)
  notes           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  account    CustomerAccount @relation(fields: [accountId], references: [id])
  site       Site?           @relation(fields: [siteId], references: [id])
  inquiries  Inquiry[]
  quotations Quotation[]

  @@index([accountId, deletedAt])
  @@index([siteId])
  // §7 matches duplicate accounts partly on the domain of a contact's email address.
  @@index([email])
}

// specs/01-crm-inquiry.md §5b — customer accreditation.
//
// The direction matters and is easy to invert: this records AIES being accredited *by* a customer,
// because Philippine industrial and utility buyers will not issue a PO to an unaccredited supplier.
// It is NOT AIES approving its own vendors — that is ISO 9001 clause 8.4, spec 08 §5, and needs
// module 03's Supplier.
//
// §5b's own framing: "This is real recurring work owned by the Admin Manager, and today it lives in
// someone's memory and a folder."
model AccreditationRecord {
  id        String @id @default(cuid())
  accountId String

  // not_started | preparing | submitted | under_review | accredited | rejected | expired | renewal_due
  status String @default("not_started")

  submittedAt  DateTime?
  accreditedAt DateTime?

  // The certificate the *customer* issues back, confirming AIES is an accredited supplier. With
  // the per-document checklist removed (docs/DECISIONS.md #19), this and `expiresAt` are the whole
  // record — the documents AIES submits to *get* accredited are lodged and tracked on the
  // customer's own portal.
  //
  // FileObject id from module 00's storage service, stored with entityType "AccreditationRecord" so
  // the access checker registered in accreditation-access.ts governs who may download it.
  certificateFileId     String?
  certificateUploadedAt DateTime?

  // Entered by hand by the assigned owner, deliberately not parsed off the certificate: these
  // arrive as scans and photographs, and a wrong date read by a machine is worse than a right one
  // typed by the person who is accountable for it. `accredited` status requires both this and the
  // certificate — see assertCanBeAccredited.
  expiresAt       DateTime?
  referenceNumber String?

  // Where AIES uploads renewals for this customer, and who chases it. Plain id rather than a
  // relation, consistent with Site.contactId.
  customerPortalUrl String?
  customerContactId String?

  // PD acknowledging that this renewal is now one of their tasks. Distinct from `status`: the
  // record can sit in `renewal_due` indefinitely with nobody having picked it up, and the whole
  // point of the acknowledgement is to start a clock against a named person.
  //
  // Cleared when the renewal completes (a new certificate and a future expiry), which is what
  // stops the escalation — see completesRenewal() in accreditation-renewal.ts.
  renewalAcknowledgedAt DateTime?
  renewalAcknowledgedBy String?

  rejectionReason String?
  notes           String?
  ownerId         String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  account CustomerAccount @relation(fields: [accountId], references: [id])

  // One live accreditation per customer. A customer either accredits you or does not; a second
  // concurrent record would make "are we accredited?" unanswerable.
  @@unique([accountId, deletedAt])
  @@index([status, expiresAt])
  @@index([ownerId])
}

// specs/01-crm-inquiry.md §2 and §3 — the inquiry.
//
// §1.2's problem table names "no CRM or pipeline tool → no forecast, no follow-up discipline, lost
// inquiries" as a thing the system must remove, and §3 answers it with an SLA on the very first
// transition. Almost everything unusual in this model is in service of that one rule.
model Inquiry {
  id     String @id @default(cuid())
  // INQ-{YY}{MM}-{####}, seeded in prisma/seed.ts's numbering formats.
  number String @unique

  // All three optional per §2. An inquiry genuinely can arrive before anyone knows which account it
  // belongs to — a call from a plant engineer who gives a site but not a company — and forcing the
  // link at creation is how you get junk accounts created to satisfy a NOT NULL.
  accountId String?
  siteId    String?
  contactId String?

  // email | website | linkedin | phone | walk_in | referral | existing_customer | trade_show.
  // `email` and `website` are unreachable today: Spec.md §3.4 removed inbound ingest, and §8 says
  // to keep the values so nothing changes when they return.
  source    String  @default("phone")
  sourceRef String?

  // Distinct from createdAt: an inquiry logged on Monday for a call taken on Friday has an SLA
  // clock that started Friday. Backdating is honest here and the SLA derivation depends on it.
  receivedAt  DateTime @default(now())
  subject     String
  description String?

  // §4's checklist answers, keyed by the template field's key. Deliberately schemaless: every
  // service type asks different questions and the templates are editable.
  requirements Json @default("{}")

  industry       String?
  estimatedValue Decimal?  @db.Decimal(14, 2)
  currency       String    @default("PHP")
  requiredByDate DateTime?

  // new | acknowledged | evaluating | inspection_required | quoting | quoted | won | lost |
  // disqualified. Transitions are enforced by inquiry-lifecycle.ts, not by this column.
  status String @default("new")

  ownerId    String
  assignedAt DateTime?

  // Light BANT (§2: "optional"). Json because a half-answered qualification is the normal case and
  // four nullable columns would imply otherwise.
  qualification Json?

  // §3: "lostReason is a required, configurable picklist. Without enforced loss reasons the
  // pipeline reports are worthless."
  lostReason       String?
  lostToCompetitor String?

  // ---- SLA (§3) ----------------------------------------------------------------------------
  // The deadline itself is NOT stored. It is derived from receivedAt + the working calendar, the
  // same reasoning as the accreditation status: a stored deadline is a second copy of a fact that
  // goes stale the moment the SLA setting changes, and nothing runs before a page is opened.
  acknowledgedAt DateTime?

  // §5: "Inquiry status is inspection_required while open; SLA clock pauses." Paused time is
  // accumulated in *business* milliseconds so a pause spanning a weekend does not consume budget
  // the customer would never have counted.
  slaPausedAt DateTime?
  slaPausedMs Int       @default(0)

  // Stamped when the escalation notification goes out, so the nightly sweep escalates once rather
  // than every night until someone acts. Clearing it is not a supported operation: an inquiry that
  // breached its SLA breached it.
  slaEscalatedAt DateTime?

  // ---- §4 completeness gate ------------------------------------------------------------------
  // "or the user explicitly overrides with a reason (logged)". Stored as well as audited: the audit
  // log is the evidence, this is what the screen shows the next person who opens the record.
  requirementsOverrideReason String?
  requirementsOverrideBy     String?
  requirementsOverrideAt     DateTime?

  // §6's follow-up engine: "Nothing is allowed to sit with no next step." Not yet swept — that is
  // session 3 — but captured now so the field exists before there is history to backfill.
  nextFollowUpAt DateTime?

  customFields Json @default("{}")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Settled and filed away, so the live list is the work that still needs somebody.
  ///
  /// Not a status: an inquiry is `won` or `lost` whether or not anybody has tidied it, and folding
  /// the two together would mean the act of filing changed what happened. This is the shelf, not
  /// the outcome.
  archivedAt   DateTime?
  archivedById String?

  deletedAt DateTime?
  deletedBy String?

  account     CustomerAccount?    @relation(fields: [accountId], references: [id])
  site        Site?               @relation(fields: [siteId], references: [id])
  contact     Contact?            @relation(fields: [contactId], references: [id])
  items       InquiryItem[]
  inspections InspectionRequest[]
  quotations  Quotation[]
  customerPOs CustomerPO[]

  @@index([ownerId, status])
  @@index([status, receivedAt])
  @@index([accountId, deletedAt])
  // The nightly SLA sweep's exact query: unacknowledged, never escalated, not deleted.
  @@index([acknowledgedAt, slaEscalatedAt, deletedAt])
}

// What the customer asked for, before anyone has costed it (§2).
//
// Separate from module 02's quotation lines on purpose: this is the customer's words, and the
// quotation's are AIES's. Overwriting one with the other loses the ability to answer "is what we
// quoted actually what they asked for?", which is where scope disputes start.
model InquiryItem {
  id        String @id @default(cuid())
  inquiryId String
  lineNo    Int

  description String
  quantity    Decimal @default(1) @db.Decimal(14, 3)
  unit        String  @default("pc")

  manufacturer   String?
  modelNumber    String?
  specifications Json?

  // supply | installation | commissioning | calibration | pm | corrective | inspection.
  // Drives which §4 requirements template applies, so an inquiry with three line types asks for
  // all three checklists.
  serviceType String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, lineNo])
  @@index([inquiryId])
}

// Calls, meetings, site visits — the relationship record (§2).
//
// This is NOT module 00's activity feed. That feed merges comments with audit rows and answers
// "what happened to this record?"; this model answers "when did we last actually talk to these
// people?", which §1 says is the salesperson's real question ("who haven't I talked to in 60
// days?"). A phone call is not an audit event — nothing in the system changed — so it needs its own
// row.
//
// Polymorphic by entityType/entityId, matching AuditLog and Comment, because the same call can be
// about an account, an inquiry or a quotation and a foreign key per target would mean a schema
// change for every new one.
model Activity {
  id         String @id @default(cuid())
  entityType String
  entityId   String

  // call | meeting | site_visit | email | note | demo
  type        String
  subject     String
  body        String?
  occurredAt  DateTime
  durationMin Int?

  // Plain arrays rather than join tables: these are read whole, never queried across, and a join
  // table for "who was on the call" would be three more models nobody reads independently.
  participantIds String[] @default([])
  contactIds     String[] @default([])

  outcome     String?
  nextStepDue DateTime?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  @@index([entityType, entityId, occurredAt])
  @@index([createdById, occurredAt])
}

// specs/01-crm-inquiry.md §4 — "a requirements checklist template per service type, editable in
// settings".
//
// A model rather than a constant precisely because §4 says editable: the whole value is that the
// engineer who keeps being asked "what did they not tell us?" can add the question themselves. A
// code constant would put that behind a deploy.
model RequirementTemplate {
  id          String @id @default(cuid())
  // supply | installation | commissioning | calibration | pm | corrective | inspection — matches
  // InquiryItem.serviceType, which is how a template is selected.
  serviceType String @unique
  label       String

  // [{ key, label, type, required, help?, options? }]. Json because the field list is the thing
  // being edited; a Field model would make adding a question a two-table transaction and buy
  // nothing, since nothing queries an individual field.
  fields Json @default("[]")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// specs/01-crm-inquiry.md §5 — sales asking the technical team to look at a site before a quotation
// can be written.
//
// §5: "Module 04 subscribes and creates a scheduled field task... Until module 04 exists, the
// request is a task assigned to a user with a due date." So this model carries the assignment
// itself. When module 04 lands it consumes `inspection.requested` and this becomes the request of
// record with the field task alongside it — which is why assignedToId and dueAt are nullable
// rather than required: module 04 will own scheduling.
model InspectionRequest {
  id        String  @id @default(cuid())
  inquiryId String
  siteId    String?

  purpose         String
  // §5's "specific questions to answer" and "required outputs (photos, tag list, measurements)".
  // The point of both is that a site visit which answers the wrong question costs another visit.
  questions       String?
  requiredOutputs String[] @default([])

  // The requested window, not a fixed date: sites grant access when they grant it.
  windowStart DateTime?
  windowEnd   DateTime?

  // requested | scheduled | completed | cancelled
  status       String    @default("requested")
  assignedToId String?
  dueAt        DateTime?

  completedAt  DateTime?
  // The completed report, attached back to the inquiry per §5. A FileObject id from module 00
  // storage; module 04 will replace this with a real field report.
  reportFileId String?
  findings     String?

  requestedById String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedBy     String?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id])
  site    Site?   @relation(fields: [siteId], references: [id])

  @@index([inquiryId])
  @@index([assignedToId, status])
  @@index([status, dueAt])
}

// specs/01-crm-inquiry.md §5c — principal supplier and product acquisition (EM).
//
// §5c's framing is the design brief: "EM's job includes acquiring new products and new principal
// suppliers. That is a pipeline, and it deserves the same treatment as the sales pipeline rather
// than living in an inbox."
//
// So this is a second pipeline with the same shape as the inquiry's, pointed the other way: AIES
// pursuing a manufacturer rather than a customer pursuing AIES. Two fields carry most of the value
// and neither is obvious — the agreement expiry and the price-list validity, because §5c is blunt
// about the cost of missing them: "A quotation costed from a lapsed price list is a margin incident
// waiting to happen."
model PrincipalProspect {
  id           String   @id @default(cuid())
  companyName  String
  country      String?
  website      String?
  // The product lines AIES would be selling. Array rather than a join table for the same reason as
  // Activity.participantIds: read whole, never queried across.
  productLines String[] @default([])

  contactName String?
  email       String?
  phone       String?

  // identified | contacted | in_discussion | samples_pricing | agreement_draft | appointed |
  // declined | dormant. Enforced by principal-lifecycle.ts, not by this column.
  stage String @default("identified")

  ownerId          String
  targetIndustries String[] @default([])
  competingBrands  String[] @default([])

  estimatedOpportunity Decimal? @db.Decimal(14, 2)

  // The distributor agreement and its terms. `agreementExpiresAt` gets the same renewal ladder as
  // §5b's accreditation, for the same reason: an agreement that lapses unnoticed means AIES is
  // quoting a brand it is no longer appointed for.
  distributorAgreementFileId String?
  agreementSignedAt          DateTime?
  agreementExpiresAt         DateTime?
  // none | territory | segment
  exclusivity                String    @default("none")

  // §5c: "Price list expiry tracking." Module 02 warns on stale supplier costs and this feeds it.
  priceListFileId     String?
  priceListReceivedAt DateTime?
  priceListValidUntil DateTime?

  trainingStatus     String?
  technicalContactId String?
  notes              String?
  nextFollowUpAt     DateTime?

  // Appointed without the signed agreement on file, which the company asked for: "sometimes these
  // are not needed for small suppliers". Only the president and vice-president can do it and only
  // with a written reason, so this is the record of who set the requirement aside and why — the
  // same shape as Inquiry.requirementsOverride*, and for the same reason: the audit log is the
  // evidence, these three columns are what the next person to open the record actually sees.
  appointmentOverrideReason String?
  appointmentOverrideBy     String?
  appointmentOverrideAt     DateTime?

  // Set when the prospect converts (§5c: "On `stage = appointed`, the prospect converts into a
  // `Supplier` (module 03) with `isPrincipal = true`"). Its presence is also what stops a second
  // conversion.
  //
  // **A real foreign key as of module 03.** It was a plain id from session 3, documented as
  // "becomes a foreign key on the day that model exists" — that day arrived. `@unique` because §10
  // asks that appointing "creates exactly one supplier", and a constraint says that better than a
  // service check nobody can bypass by accident.
  supplierId String?   @unique
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  @@index([stage, ownerId])
  @@index([ownerId, nextFollowUpAt])
  // The nightly expiry sweeps scan these two directly.
  @@index([agreementExpiresAt])
  @@index([priceListValidUntil])
}
