/// Module 05 — Finance, Billing and Collections (specs/05-finance-billing.md).
///
/// Session 1 builds §2: the billing schedule, and the milestone triggers that tell finance a
/// milestone is billable without anybody having to ask operations whether the work is done. §1 of
/// the spec is explicit that this module is **not** double-entry accounting, so there is no chart of
/// accounts here and there will not be one.

/// `PaymentTerm` is **module 02's model**, extended there rather than duplicated here.
///
/// It already existed with `downpaymentPct`, `balanceTrigger` and `netDays`, and its own comment
/// anticipated this: "module 05 reads it for billing". A second finance-owned payment term would
/// have meant two answers to "what did this customer agree to", and the one a quotation printed
/// would not have been the one an invoice billed.
///
/// What module 05 adds there is `milestones` — the richer expression of the same fact. See the note
/// on that field for which one governs billing.

/// One order's billing plan, fixed at the moment it was generated.
///
/// It records `termSnapshot` as well as `paymentTermId`. A term is a piece of configuration somebody
/// can edit, and an order billed under the old 50/50 must not silently re-plan itself when the term
/// becomes 30/70 next year. The snapshot is what this order agreed to; the id is where it came from.
model BillingSchedule {
  id            String @id @default(cuid())
  salesOrderId  String @unique
  paymentTermId String

  /// The term's milestones as they stood when this schedule was generated.
  termSnapshot Json

  generatedAt   DateTime @default(now())
  generatedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  paymentTerm PaymentTerm        @relation(fields: [paymentTermId], references: [id])
  milestones  BillingMilestone[]

  @@index([paymentTermId])
}

/// A slice of an order's value, and the event that makes it billable.
model BillingMilestone {
  id           String @id @default(cuid())
  scheduleId   String
  salesOrderId String

  /// Position in the schedule, so "the downpayment" is identifiable without matching on its label.
  sequence Int
  label    String

  /// Percentage of the order value, to four places. Kept alongside `amount` rather than replaced by
  /// it: the percentage is what was agreed, the amount is what that came to at generation time, and
  /// a variation order changes the second without changing the first.
  pct    Decimal @db.Decimal(7, 4)
  /// Integer centavos, like every other money field in the platform.
  amount Int

  /// See BILLING_TRIGGERS in billing-rules.ts.
  trigger String

  /// pending | ready_to_bill | invoiced | cancelled
  status String @default("pending")

  /// When the trigger fired. Null while pending — and null is the honest answer, not a date nobody
  /// has earned.
  readyAt     DateTime?
  /// Why it became billable: the event that did it, for the person asking "why is this on my list".
  readyReason String?
  dueDate     DateTime?

  /// Set when a billing statement is raised against it. §3 keeps the statement and the invoice
  /// separate documents; this points at the first.
  billingStatementId String?

  cancelledAt     DateTime?
  cancelledReason String?

  version   Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  schedule BillingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, sequence])
  @@index([salesOrderId, status])
  @@index([status, trigger])
  @@index([status, dueDate])
}


/// §6's direct expenses — the costs that arrive as an invoice rather than through a crew.
///
/// Subcontractors, permits, equipment rental, third-party calibration. §6 lists seven sources of
/// project cost and six of them already exist elsewhere: landed cost on a supplier PO, liquidated
/// cash advance lines, field expenses, labour from timesheets, materials issued from stock, and
/// rework from failed QA. This is the seventh, and the only one with nowhere else to live.
///
/// **It is deliberately not a second FieldExpense.** That model is a technician's out-of-pocket
/// spend on a job — small, cash, receipt-in-a-pocket, and gated on §5's ₱499 rule. This is an
/// invoice from a company, approved by somebody with authority to commit money, and it is the shape
/// module 05 §7's payables will grow into. Collapsing the two would force one approval path onto two
/// different acts.
model Expense {
  id     String @id @default(cuid())
  /// AIESEXP-{YY}{####}.
  number String @unique

  category    String
  vendorName  String?
  expenseDate DateTime

  amount    Decimal  @db.Decimal(14, 2)
  currency  String   @default("PHP")
  /// Input VAT, where the invoice separates it. Null means nobody has recorded it, which is not the
  /// same as an invoice with no VAT on it — the second is a zero.
  vatAmount Decimal? @db.Decimal(14, 2)

  description String

  /// Where the cost lands. §6's P&L reads by project; the sales order is carried because a job
  /// whose project was never created still has costs, and losing them would flatter the margin.
  salesOrderId String?
  projectId    String?
  ticketId     String?

  paymentMethod  String?
  receiptFileIds String[] @default([])

  /// draft | submitted | approved | rejected | paid (§6).
  ///
  /// Only `approved` and `paid` count towards project cost. A submitted expense is a claim, and
  /// counting claims as cost would make every project look worse the moment somebody typed
  /// something, then better when it was rejected.
  status String @default("draft")

  submittedById String
  approvedById  String?
  approvedAt    DateTime?
  paidAt        DateTime?
  rejectedReason String?

  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId, status])
  @@index([salesOrderId])
  @@index([status, expenseDate])
}

/// What an hour of somebody's time costs the company, from a date.
///
/// §6 computes labour cost as approved timesheet hours × the user's cost rate. That rate changes —
/// people are promoted, minimum wage moves, a contractor's rate is renegotiated — and a project
/// costed last year must keep the rate that applied then. Hence `effectiveFrom` and a row per
/// change rather than a column on `User`.
///
/// **This is cost, not salary.** It is the fully-loaded hourly figure the company uses to price and
/// to measure a job: pay plus statutory contributions plus the share of overhead the business
/// chooses to attribute. Nobody's take-home pay is derivable from it, which is deliberate — see the
/// permission on the P&L screen.
model CostRate {
  id     String @id @default(cuid())
  userId String

  effectiveFrom DateTime @db.Date

  hourlyCost Decimal @db.Decimal(12, 2)
  /// Overtime multiplier — 1.25 under Philippine rules for ordinary overtime, higher on rest days
  /// and holidays. Stored per rate because it is negotiated alongside it.
  overtimeMultiplier Decimal @default(1.25) @db.Decimal(5, 2)
  /// Travel and standby are usually paid at plain time even when the day runs long. Separate
  /// multipliers so a company that treats them differently does not have to fake it with a blended
  /// hourly figure that then misprices ordinary work.
  travelMultiplier   Decimal @default(1) @db.Decimal(5, 2)
  standbyMultiplier  Decimal @default(1) @db.Decimal(5, 2)

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// One rate per person per start date. A second row for the same day is a correction, and
  /// corrections replace rather than accumulate.
  @@unique([userId, effectiveFrom])
  @@index([userId, effectiveFrom])
}
