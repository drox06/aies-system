// Module 02 — Quotation. specs/02-quotation.md §2.
//
// §1 is the design brief and it is unusually direct: "Everything AIES sells is quoted
// individually. The quotation is where margin is decided, where scope is defined, and where the
// company's technical credibility is expressed... This module deserves more care than any other."
//
// Three consequences run through every model below.
//
// **Money is Decimal, never Float.** A quotation is a legal offer; a centavo of binary rounding is
// a number the customer can dispute. Costs, prices and totals are Decimal(14,2); quantities carry
// three decimals for part-units; rates and percentages carry more precision than they display,
// because a rate is multiplied before it is rounded.
//
// **Historical facts are stored, not recomputed.** `costFxRate` is the rate used at the moment of
// quoting, not today's rate (§4: "Never overwrite a historical rate"). The same applies to
// `lineCost` and `lineMargin`: recomputing them later from a changed markup would silently rewrite
// what the company decided last March.
//
// **Cost and margin are permission-gated at the service layer** (Spec.md §4.3), not hidden in the
// UI. They live on the model in the open; `finance.view_cost` decides whether they reach the wire.

model Quotation {
  id String @id @default(cuid())

  // The company's own convention, not Spec.md §5's placeholder: AIESLQ{YY}{####} for local
  // customers and AIESIQ{YY}{####} for indent/international, with `REV01` appended from revision 1.
  // Two independent series, each restarting each January. See docs/DECISIONS.md #25 and
  // src/server/core/quotation/quotation-number.ts.
  number   String
  revision Int    @default(0)

  // local | indent. Decides which series the number came from, so it is stored rather than parsed
  // back off the prefix — a quote type that disagreed with its own number would be unresolvable.
  quoteType String @default("local")

  // The root of the revision chain. Null on R0, so the chain is "everything with this
  // parentQuotationId, plus the row it points at".
  parentQuotationId String?

  // §10 consumes `inquiry.quoting_started`, so most quotations arrive from an inquiry — but not
  // all: §9's "duplicate quotation to a different account" produces one with no inquiry behind it.
  inquiryId String?
  accountId String
  siteId    String?
  contactId String?

  title       String
  // §1: "where scope is defined". The technical narrative is the artefact the customer actually
  // reads, and §7 puts it on the PDF above the line table.
  scopeOfWork String
  exclusions  String?
  assumptions String?

  // draft | pending_approval | approved | sent | under_negotiation | accepted | rejected |
  // expired | superseded | cancelled. Enforced by quotation-lifecycle.ts, not by this column.
  status String @default("draft")

  currency    String  @default("PHP")
  // The rate used to convert supplier FX cost to PHP *at the time of quoting*. Six decimals
  // because a rate is multiplied across every line before anything is rounded.
  fxRate      Decimal @default(1) @db.Decimal(12, 6)
  // §4's "quote at BSP rate + 3%" buffer. Stored separately from the rate so the PDF and the
  // margin panel can show it explicitly — §4: "it is a margin decision, not a hidden fudge."
  fxBufferPct Decimal @default(0) @db.Decimal(7, 4)

  validUntil DateTime

  deliveryTermIncoterm String?
  deliveryLeadTime     String?
  // Plain id rather than a relation until PaymentTerm has rows; see the model below.
  paymentTermsId       String?
  // Free text alongside the id. Module 05 owns PaymentTerm and has no rows yet, and the company
  // writes terms as a sentence ("100% Advance payment") rather than picking from a list. When
  // module 05 lands the id becomes the structured link and this stays as the printed wording.
  paymentTermsText     String?
  warrantyTerms        String?

  // Commercial summary, all denominated in `currency`.
  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  // exclusive | inclusive | zero_rated | exempt (§4).
  vatMode        String  @default("exclusive")
  vatRatePct     Decimal @default(12) @db.Decimal(7, 4)
  vatAmount      Decimal @default(0) @db.Decimal(14, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)

  // Permission-gated on the way out (§4's margin panel, Spec.md §4.3).
  totalCost    Decimal @default(0) @db.Decimal(14, 2)
  marginAmount Decimal @default(0) @db.Decimal(14, 2)
  marginPct    Decimal @default(0) @db.Decimal(7, 4)

  preparedById String
  approvedById String?
  approvedAt   DateTime?

  // The document was produced and somebody has it. Deliberately **not** the same as sent: the PDF
  // leaves this app in a browser download and is attached to an external mail client, which this
  // system cannot observe. Recording the download is the last fact it can establish on its own.
  downloadedAt  DateTime?
  downloadedBy  String?
  // Counted rather than replaced, so "downloaded three times and still not sent" is visible. A
  // quotation re-downloaded repeatedly is usually one somebody keeps meaning to send.
  downloadCount Int       @default(0)

  // Asserted by a person, because nothing here can watch an outbound email.  is the date it
  // actually went, which is not always the date somebody ticked the box — people send on Friday and
  // confirm on Monday, and the customer's clock runs from the former.
  sentAt           DateTime?
  sentConfirmedAt  DateTime?
  sentConfirmedBy  String?
  sentToContactIds String[]  @default([])

  decisionAt      DateTime?
  // Why the **VP** sent it back to draft (§6). Distinct from `lostReason` below, which is why the
  // *customer* said no — conflating them would make a report about internal rework and one about
  // lost business read from the same column.
  rejectionReason String?

  // §8's win/loss analytics. `lostReason` uses module 01's LOST_REASONS picklist, deliberately, so
  // a loss recorded on a quotation and one recorded on an inquiry aggregate together instead of
  // being two vocabularies for one question.
  lostReason String?
  competitor String?

  // §5's revision reason — ISO 9001 clause 8.2.4 evidence for changes to requirements.
  revisionReason String?
  revisionNote   String?

  // Spec.md §10 requires optimistic locking on quotations by name. §12: "Concurrent edit of one
  // quotation by two users raises a version conflict rather than a silent overwrite."
  version Int @default(0)

  // §7'''s standard terms, per quotation and editable line by line.
  //
  // Stored on the record rather than read from a constant at print time, because a quotation is a
  // contract: the clauses the customer accepted are the ones that were on the document they signed,
  // not the ones the company happens to be using six months later. Seeded from
  // DEFAULT_TERMS_AND_CONDITIONS on creation.
  termsAndConditions Json @default("[]")

  customFields Json @default("{}")

  // Off the working list, at the company's request: a quotation whose purchase order arrived is
  // finished sales work, and 14 days later it stops competing for attention with live ones.
  //
  // **Not a delete and not a status.** `deletedAt` means the record should not have existed;
  // `status` is what the *customer* did. Archiving is neither — it is a statement about which
  // screen a finished document belongs on, which is why it is its own column and why an archived
  // quotation still reports as `accepted`. Only the president and vice-president can see the
  // archive (`quotation.view_archive`), so this also has to be a filter the list applies rather
  // than a flag the UI hides.
  archivedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  /// specs/04-operations-projects.md §6.1's scope change, carried on the document it affects.
  ///
  /// §6.1 calls the inspection-to-quotation link "one of the highest-value things the platform
  /// does", and module 04 emits `scope_change.identified` for it. The notification that follows is
  /// a nudge; **these columns are the record**, and they exist because a nudge is not enough on its
  /// own. The in-app bell is the only channel with a handler today (docs/DECISIONS.md #10), so a
  /// notification nobody happens to see is a scope change nobody ever learns about — and the crew
  /// mobilises three weeks later against a quotation that was never revised.
  ///
  /// So the flag stays on the quotation until somebody either revises it or dismisses it with a
  /// reason. docs/DECISIONS.md #59.
  scopeChangeFlaggedAt    DateTime?
  scopeChangeNotes        String?
  /// The inspection that found it, for a link, and its number, for a sentence.
  scopeChangeInspectionId String?
  scopeChangeSource       String?
  /// Last time the nightly sweep chased it. Null until the first chase.
  scopeChangeChasedAt     DateTime?

  scopeChangeResolvedAt     DateTime?
  scopeChangeResolvedById   String?
  /// revised | dismissed. Set by reviseQuotationService automatically, or by an explicit dismissal.
  scopeChangeResolution     String?
  /// Required when dismissing. "We absorbed it" is a decision worth keeping; silence is not.
  scopeChangeResolutionNote String?

  account           CustomerAccount        @relation(fields: [accountId], references: [id])
  inquiry           Inquiry?               @relation(fields: [inquiryId], references: [id])
  site              Site?                  @relation(fields: [siteId], references: [id])
  contact           Contact?               @relation(fields: [contactId], references: [id])
  parent            Quotation?             @relation("QuotationRevisions", fields: [parentQuotationId], references: [id])
  children          Quotation[]            @relation("QuotationRevisions")
  lines             QuotationLine[]
  rfqs              SupplierQuoteRequest[]
  customerPOs       CustomerPO[]
  negotiationRounds NegotiationRound[]
  salesOrders       SalesOrder[]

  // One row per revision of a number.
  @@unique([number, revision])
  @@index([accountId, status])
  @@index([status, validUntil])
  @@index([preparedById, status])
  @@index([inquiryId])
  // The nightly sweep's query: flagged and not yet resolved.
  @@index([scopeChangeFlaggedAt, scopeChangeResolvedAt])
}

model QuotationLine {
  id          String  @id @default(cuid())
  quotationId String
  lineNo      Int
  // §2: group by "Supply" / "Installation" / "Spares". Free text rather than an enum — the
  // grouping is presentational and every job groups differently.
  groupLabel  String?

  // product | service | labour | travel | freight | misc
  itemType String @default("product")

  productId       String?
  description     String
  longDescription String?
  manufacturer    String?
  modelNumber     String?
  partNumber      String?

  quantity Decimal @default(1) @db.Decimal(14, 3)
  unit     String  @default("pc")

  // As quoted by the principal, in their currency, with the rate used at the time (§4).
  unitCost     Decimal @default(0) @db.Decimal(14, 2)
  costCurrency String  @default("PHP")
  costFxRate   Decimal @default(1) @db.Decimal(12, 6)

  /// This line's own FX cushion, when the header's figure does not fit it.
  ///
  /// Null means "use the quotation's". The header stays the house position; this is the exception,
  /// the same way `markupPct` works.
  ///
  /// It exists because lines already carry their own `costCurrency`: one quotation can hold a USD
  /// line, a EUR line and a locally-sourced PHP line, and a single header buffer applied a USD-sized
  /// cushion to all three — including the PHP line, which carries no exchange risk whatsoever. That
  /// inflated its cost, crushed its apparent margin, and priced AIES out of local supply for a risk
  /// that does not exist. Raised by the company on 2026-08-18.
  fxBufferPct Decimal? @db.Decimal(7, 4)

  // §4 supports both pricing modes: markup on cost, or a directly entered price with implied
  // margin. `markupPct` is null when the price was typed rather than derived — which is itself
  // information, so it is not defaulted to zero.
  markupPct       Decimal? @db.Decimal(7, 4)
  unitPrice       Decimal  @default(0) @db.Decimal(14, 2)
  lineDiscountPct Decimal? @db.Decimal(7, 4)

  // Computed at save time and stored, because they are what the customer was told. See the header
  // comment on recomputation.
  lineTotal  Decimal @default(0) @db.Decimal(14, 2)
  lineCost   Decimal @default(0) @db.Decimal(14, 2)
  lineMargin Decimal @default(0) @db.Decimal(14, 2)

  // §3.5: "The link is what lets anyone later answer 'where did this cost come from?'"
  supplierQuoteLineId String?

  leadTimeDays Int?
  // §7: optional/alternate lines are shown but excluded from the total.
  isOptional   Boolean @default(false)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@unique([quotationId, lineNo])
  @@index([quotationId])
  @@index([productId])
}

// §3 — the RFQ sent to a principal. "Make that coordination a first-class record instead of an
// email nobody can find."
model SupplierQuoteRequest {
  id     String @id @default(cuid())
  number String @unique

  quotationId String?
  inquiryId   String?
  // A real foreign key at last, and it took a data migration to get here.
  //
  // This column used to hold a **`PrincipalProspect` id**: module 01's appointed principals were
  // the interim answer to "who do we ask for pricing", so every RFQ ever raised pointed at one.
  // `scripts/backfill-suppliers-from-principals.ts` created the `Supplier` for each appointed
  // prospect and repointed the RFQs, in that order, which is what let the constraint hold.
  //
  // Future appointments convert automatically — the order manifest subscribes to
  // `principal.appointed`, which is §5c's "no re-keying" promise finally kept.
  supplierId  String

  // draft | sent | responded | declined | expired
  status String @default("draft")

  sentAt      DateTime?
  dueBy       DateTime?
  respondedAt DateTime?

  requestBody   String
  responseNotes String?

  currency     String?
  validUntil   DateTime?
  leadTimeDays Int?

  // §3.4: the supplier's own PDF, attached as evidence of what they actually quoted.
  responseFileId String?

  requestedById String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedBy     String?

  quotation Quotation?          @relation(fields: [quotationId], references: [id])
  lines     SupplierQuoteLine[]
  supplier  Supplier            @relation(fields: [supplierId], references: [id])

  @@index([supplierId, status])
  // The §3.3 overdue sweep's exact query.
  @@index([status, dueBy])
  @@index([quotationId])
}

model SupplierQuoteLine {
  id        String @id @default(cuid())
  requestId String
  lineNo    Int

  // The quotation line this was raised from, by **line number** rather than by id.
  //
  // `saveQuotationLinesService` deletes and recreates every line on each save, so a `QuotationLine`
  // id is not stable and a foreign key to it would dangle after the next edit. Line number is what
  // the rest of this module already matches on (see the cost-preservation logic in that service).
  //
  // Recorded rather than inferred from position: an RFQ raised on quotation lines 2 and 5 has RFQ
  // lines 1 and 2, and without this the mapping back is gone. Null when a line was typed straight
  // into the RFQ — asking a supplier about something not yet on the quotation is legitimate.
  sourceLineNo Int?

  description  String
  manufacturer String?
  modelNumber  String?

  quantity     Decimal @default(1) @db.Decimal(14, 3)
  unit         String  @default("pc")
  unitCost     Decimal @default(0) @db.Decimal(14, 2)
  currency     String  @default("PHP")
  leadTimeDays Int?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request SupplierQuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, lineNo])
  @@index([requestId])
}

// §9: "a light catalogue that grows from usage... The catalogue thus builds itself from real work
// rather than requiring a data-entry project up front."
model Product {
  id  String  @id @default(cuid())
  sku String? @unique

  name         String
  description  String?
  manufacturer String
  modelNumber  String?

  // Free text rather than a Category model: §9 wants this to accrete from real quotes, and a
  // mandatory category picker at creation time is exactly the friction that stops that happening.
  category String?
  unit     String  @default("pc")

  defaultSupplierId String?

  // The last cost actually seen, so §9's duplicate-quotation flow can flag stale pricing.
  lastCost         Decimal?  @db.Decimal(14, 2)
  lastCostCurrency String?
  lastCostAt       DateTime?
  defaultMarkupPct Decimal?  @db.Decimal(7, 4)

  datasheetFileId String?
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines QuotationLine[]

  @@index([manufacturer, modelNumber])
  @@index([isActive, name])
}

// §2. Owned here because module 02 is the first module to need it; module 05 reads it for billing
// and module 03 for supplier terms.
model PaymentTerm {
  id   String @id @default(cuid())
  name String @unique

  downpaymentPct Decimal @default(0) @db.Decimal(7, 4)
  // e.g. "on delivery" | "on completion" | "on invoice" — what triggers the balance.
  balanceTrigger String?
  netDays        Int     @default(0)
  description    String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// §8: "Status `under_negotiation` with a structured log: each round records the customer's
// counter-position, AIES's response, who authorised it, and the resulting revision (if any)."
//
// A **log**, not fields on the quotation. A negotiation is a sequence — three rounds of push and
// counter-push is the normal case — and columns can only hold the last one. §1 makes this module the
// place the company's margin decisions are recorded, and "we came down twice and they still walked"
// is exactly the kind of thing that is invisible if only the final position is kept.
model NegotiationRound {
  id          String @id @default(cuid())
  quotationId String
  roundNo     Int

  occurredAt DateTime @default(now())

  // What they asked for, in their words where possible.
  customerPosition String
  // What AIES said back.
  aiesResponse     String

  // Who agreed to it. §8 asks for this by name because a concession is a margin decision, and the
  // person who made it should be answerable for it later.
  authorisedById String

  // The revision this round produced, if it produced one. Null when the round was a conversation
  // that changed nothing — which is itself worth recording.
  resultingQuotationId String?

  // Where the price landed after this round, so the log reads as a sequence of positions rather
  // than requiring a reader to reconstruct it from revisions.
  agreedTotal Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@unique([quotationId, roundNo])
  @@index([quotationId])
}

// §9: "Quote templates for repeat scopes (annual PM contract, standard calibration package)."
//
// **Its own model, not an `isTemplate` flag on `Quotation`.** A flag would mean every query in the
// module — the list, the pipeline, the approval queue, the expiry sweep, the win/loss report — has
// to remember to exclude templates, and the first one that forgets shows a template to a customer
// as a live quotation. It would also leave most of a `Quotation` meaningless: a template has no
// account, no number, no validity, no status, no revision and no approval.
//
// What it *is* is the shape: the scope narrative, the commercial terms, and the lines with their
// costs. Everything a repeat job has in common before anybody knows who it is for.
model QuoteTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  quoteType String @default("local")
  currency  String @default("PHP")

  // The narrative and terms, which are the slow part of writing a quotation and the part that
  // barely changes between two annual PM contracts.
  scopeOfWork          String
  exclusions           String?
  assumptions          String?
  deliveryTermIncoterm String?
  deliveryLeadTime     String?
  paymentTermsText     String?
  warrantyTerms        String?

  vatMode     String  @default("exclusive")
  vatRatePct  Decimal @default(12) @db.Decimal(7, 4)
  fxBufferPct Decimal @default(0) @db.Decimal(7, 4)

  // Deactivated rather than deleted: a template that produced quotations is part of how they came
  // to look the way they do.
  isActive Boolean @default(true)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines QuoteTemplateLine[]

  @@index([isActive, name])
}

model QuoteTemplateLine {
  id         String @id @default(cuid())
  templateId String
  lineNo     Int

  groupLabel      String?
  itemType        String  @default("product")
  productId       String?
  description     String
  longDescription String?
  manufacturer    String?
  modelNumber     String?
  partNumber      String?

  quantity Decimal @default(1) @db.Decimal(14, 3)
  unit     String  @default("pc")

  // Raw supplier cost and its rate, exactly as `QuotationLine` stores them (docs/DECISIONS.md #32).
  // A template's costs are a starting point and will usually be stale — §9's refresh-costs prompt is
  // what catches that once a real quotation exists.
  unitCost     Decimal  @default(0) @db.Decimal(14, 2)
  costCurrency String   @default("PHP")
  costFxRate   Decimal  @default(1) @db.Decimal(12, 6)
  markupPct    Decimal? @db.Decimal(7, 4)

  lineDiscountPct Decimal? @db.Decimal(7, 4)
  leadTimeDays    Int?
  isOptional      Boolean  @default(false)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, lineNo])
  @@index([templateId])
}
