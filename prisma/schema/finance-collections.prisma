/// Module 05 §5 — collections.
///
/// The half of finance that is not arithmetic. Ageing tells you what is late; this is the record of
/// what anybody did about it, which is the part that actually recovers money.

/// One attempt to collect: a call, an email, a visit, a promise.
///
/// ## Why this is a log rather than fields on the statement
///
/// A collection is a sequence — four calls and two broken promises is the normal case — and columns
/// can only hold the last one. The same reasoning as module 02's negotiation log: "we chased twice
/// and they promised the 15th" is exactly the kind of thing that is invisible if only the most
/// recent contact is kept, and it is what somebody needs before deciding whether to escalate.
model CollectionActivity {
  id          String @id @default(cuid())
  statementId String
  accountId   String

  /// call | email | visit | letter | promise_broken | note
  type String

  contactedAt DateTime @default(now())
  /// Who at the customer, when it was a person rather than a system.
  contactId   String?
  contactName String?

  notes String

  /// When they said they would pay. §5 asks for it on the worklist because a promised date is the
  /// single most useful thing to know before making the next call — chasing somebody the day after
  /// they promised the 15th damages a relationship for nothing.
  promisedDate DateTime?

  /// reached | no_answer | promised | disputed | refused | left_message
  outcome String?

  byId      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([statementId, contactedAt])
  @@index([accountId, contactedAt])
  @@index([promisedDate])
}

/// docs/DECISIONS.md #188. EA's own dunning cycle, replacing the fixed-offset `CollectionReminder`
/// sweep entirely — that one sent five scheduled reminders and stopped; this one runs, by name,
/// "until payment is received."
///
/// One row per statement, created the moment it matures (its due date arrives) and closed the moment
/// its balance reaches zero. Everything in between is EA's own words, verbatim:
///
/// *"once billed, maturity is tracked then finance is notified upon maturity, if closing is not done
/// within 5 days, it triggers tracking of due collectibles, notification is sent every week until
/// payment is received. when 2 notifications is sent and still no payment, it opens a when is payment
/// expected prompt, which is filled by admin. 2 days after the set date of expected to receive
/// payment notif is sent to finance and admin again if this is collected. if no payment prompt is
/// opened again, cycle repeats until payment is received."*
///
/// `state` is one of: `matured` (day 0-4, waiting to see if it closes on time) | `dunning` (day 5+,
/// weekly reminders) | `awaiting_timeline` (two reminders sent and unpaid — a person has to say when
/// to expect it, and the cycle stays here through as many missed dates as it takes) | `closed` (paid).
model CollectionCycle {
  id          String @id @default(cuid())
  statementId String @unique
  accountId   String

  state String @default("matured")

  maturedNotifiedAt DateTime?

  weeklyNotifiedCount Int       @default(0)
  lastWeeklyNotifiedAt DateTime?

  /// When the "when is payment expected" prompt most recently opened — first after two weekly
  /// reminders, then again every time a promised date passes unpaid. Sits open, un-nulled, for as
  /// long as `expectedPaymentDate` is null: that gap is what the daily escalation reads to decide
  /// whether anybody has answered it yet.
  timelinePromptOpenedAt DateTime?
  expectedPaymentDate    DateTime?
  expectedPaymentSetAt   DateTime?
  expectedPaymentSetById String?
  /// How many promised dates have come and gone unpaid. Not a threshold anything acts on by itself —
  /// it is what turns "notif sent to finance and admin" from a fact into a pattern somebody can see.
  missedDateCount        Int       @default(0)
  /// Dedupes the daily "still nobody has said when" nudge to once per calendar day, the same way
  /// `lastWeeklyNotifiedAt` dedupes the weekly ones.
  lastEscalationNotifiedAt DateTime?

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([accountId, state])
}
