/// Module 06 — Collaboration Workspace (specs/06-collaboration.md).
///
/// §1 states the problem in the company's own words: *"All work assignments are done thru meetings
/// without proper documentation."* The spec's reading of that is the thing to hold on to —
///
/// > Work is assigned in a way that produces no record. The fix is not "build a chat app" — a chat
/// > app produces no record either.
///
/// So `Task` comes first and `Channel` comes second, and the field that carries the whole argument
/// is `entityId`: a task hangs off the record it serves rather than floating on a board.

/// §2's task — the Trello replacement, and the unit of accountability the company currently lacks.
model Task {
  id     String @id @default(cuid())
  /// AIESTSK-{YY}{####} from the numbering service.
  number String @unique

  title       String
  description String?

  /// The record this task serves — an inquiry, quotation, sales order, ticket, project, cash
  /// advance, material request.
  ///
  /// Plain strings rather than a relation, and deliberately: a task can attach to any of seven
  /// models across five modules, and a real foreign key would mean either seven nullable columns or
  /// module 06 importing every other module's schema. The same shape `FileObject` and `AuditLog`
  /// already use for the same reason.
  ///
  /// Both nullable, because §2 also allows a free-standing task — "book the Christmas party" belongs
  /// to no record and is still work somebody owes.
  entityType String?
  entityId   String?

  /// §2's boards. Plain ids until session 3 builds `Board`; a task with no board is not homeless,
  /// it simply has not been placed on one, and My Work reads assignee rather than board.
  boardId  String?
  columnId String?
  position Int     @default(0)

  assigneeId String?
  /// People who want to know without owning it. §2 keeps watchers separate from the assignee
  /// because a task with five owners has none.
  watcherIds String[] @default([])

  /// todo | in_progress | blocked | for_review | done | cancelled (§2).
  status   String @default("todo")
  /// low | normal | high | urgent (§2). `urgent` is also what §7's quiet hours let through.
  priority String @default("normal")

  dueAt       DateTime?
  startAt     DateTime?
  completedAt DateTime?

  /// When it was put in somebody's hands.
  ///
  /// Its own column rather than a read of `updatedAt`, which moves on any edit — retitling a task
  /// would silently restart every age measured from it. The same fault `Timesheet.submittedAt` was
  /// added to avoid on 2026-08-20, and §8 emits `task.overdue`, so an honest clock is load-bearing
  /// here rather than decorative.
  assignedAt DateTime?

  /// What somebody thought it would take, and what it took. Both nullable: an unestimated task is
  /// ordinary, and a zero would be an estimate somebody later averages.
  estimateHours Decimal? @db.Decimal(6, 2)
  actualHours   Decimal? @db.Decimal(6, 2)

  labels    String[] @default([])
  /// `[{ text, done }]` — §2's checklist. Json because it is read whole and never queried across.
  checklist Json     @default("[]")

  parentTaskId     String?
  /// Tasks that must finish first. An array rather than a join table for the same reason the
  /// checklist is Json: it is read with the task and never aggregated over.
  blockedByTaskIds String[] @default([])

  /// §2's routine admin work, as an RRULE string. Null for the overwhelming majority.
  recurrenceRule String?

  /// The template that created it, when an event did rather than a person (§2's trigger table).
  /// Session 2 fills this in; it exists now so the column does not arrive after there is data.
  createdByTemplate String?

  createdById String

  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  /// My Work's query: everything assigned to me that is not finished, by due date.
  @@index([assigneeId, status, dueAt])
  /// The record's own task list.
  @@index([entityType, entityId])
  @@index([boardId, columnId, position])
  @@index([status, dueAt])
}

/// §2's task template — the direct replacement for the meeting where work used to be assigned.
///
/// §1: *"All work assignments are done thru meetings without proper documentation."* A template is
/// the standing answer to "who does what when this happens", written down once instead of said aloud
/// every time. The thirteen seeded ones mirror the operations flowchart, because every box in it is
/// somebody's assignment.
model TaskTemplate {
  id   String @id @default(cuid())
  /// Stable handle. Seeds upsert on it and every task the template creates records
  /// `{key}:{taskKey}` in `Task.createdByTemplate`, which is also what makes a retried event
  /// idempotent.
  key  String @unique
  name String

  /// The domain event that fires it — `sales_order.created`, `qa.failed`.
  trigger String

  /// Narrows the trigger when the same event means different things.
  ///
  /// `{ "ticketType": "delivery" }` separates §2's two `ticket.generated` rows; `{ "result":
  /// "accepted" }` keeps a failed commissioning from raising close-out work. Null means the trigger
  /// alone is enough.
  condition Json?

  /// `TaskSpec[]` — see task-template-rules.ts. Json because it is read whole with the template and
  /// never queried across, the same reasoning as `Task.checklist`.
  tasks Json

  /// A template turned off stops creating work without losing what it said. §2 asks for the
  /// assignment mode to be configurable; switching a template off is the blunt end of that.
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([trigger, isActive])
}

/// §2's board — the kanban the company currently keeps in Trello, and the smart boards that keep
/// themselves.
///
/// > **Smart boards**: a board can be defined by a filter rather than manual placement […] This is
/// > what makes the boards stay current without a human maintaining them.
///
/// A manual board is a place cards are put. A smart board is a question asked of every task, and
/// nothing is ever placed on it — which is why `columns` means two different things depending on
/// `type`, and why the service resolves a view rather than the screen reading rows directly.
model Board {
  id   String @id @default(cuid())
  name String
  /// manual | smart (§2).
  type String @default("manual")

  /// Who it belongs to. A board is somebody's — an unowned board is one nobody tidies.
  ownerId   String
  /// Private boards are the owner's alone. §2 keeps the flag because a personal board is a
  /// legitimate thing to want and a shared one that reads as private is not.
  isPrivate Boolean @default(false)

  /// `[{ key, label, statuses? }]`.
  ///
  /// On a manual board a card sits in a column because somebody dragged it there, and `statuses` is
  /// the status a card takes on when it lands. On a smart board there is no placement at all: each
  /// column is a bucket the filter's results fall into by status.
  columns Json

  /// `{ [columnKey]: number }` — §2's WIP limits. Null on boards that do not use them.
  wipLimits Json?

  /// The question a smart board asks. Null on a manual board. See board-rules.ts for the shape.
  filterRule Json?

  /// none | assignee | priority (§2's swimlanes). Stored on the board because it is how this board
  /// is read, not a per-visit preference.
  swimlaneBy String @default("none")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, deletedAt])
}

/// §3's channel — the Slack replacement, and the reason it is not just a chat app.
///
/// §1's diagnosis is worth repeating here because it is what shapes this model: *"The fix is not
/// 'build a chat app' — a chat app produces no record either."* What makes this one produce a record
/// is `entityType`/`entityId`: a channel can belong to a project or a ticket, is created with it,
/// and is archived read-only when it closes as part of that project's record.
model Channel {
  id          String  @id @default(cuid())
  name        String
  description String?

  /// team | project | topic | direct (§3).
  type String @default("topic")

  /// A private channel is visible only to its members. Public channels are readable by anybody who
  /// can reach the platform — the company is nine people, and a wall of private channels is how a
  /// small team recreates the silence §1 is about.
  isPrivate Boolean @default(false)

  /// The record this channel belongs to, for `project` and ticket channels. Plain strings, as
  /// everywhere else in this module.
  entityType String?
  entityId   String?

  /// Denormalised membership, kept in step with `ChannelMember`.
  ///
  /// Both exist because they answer different questions: the array answers "can this person see the
  /// channel" in one read while listing channels, and the rows carry each member's own unread mark
  /// and notification level. The array is the copy; the rows are the record.
  memberIds String[] @default([])

  /// Archived, not deleted. §3: when a project closes its channel *"archives read-only and is
  /// retained as part of the project record"* — the conversation is evidence of how the job was run.
  archivedAt DateTime?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members  ChannelMember[]
  messages Message[]

  @@index([type, archivedAt])
  @@index([entityType, entityId])
}

/// §3's membership, with the two things that belong to a person rather than to the channel.
model ChannelMember {
  id        String @id @default(cuid())
  channelId String
  userId    String

  /// Everything after this is unread. Null means they have never opened it.
  lastReadAt        DateTime?
  /// all | mentions | none (§3, and §7's quiet hours read it).
  notificationLevel String    @default("all")

  joinedAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

/// §3's message.
model Message {
  id        String @id @default(cuid())
  channelId String
  authorId  String

  body String

  /// The message this one is replying to. §3's threading is one level deep by design: a reply to a
  /// reply attaches to the same root, so a thread cannot become a tree nobody can follow.
  threadRootId String?

  /// User ids named with `@`. Stored rather than re-parsed, because the notification has already
  /// been sent against this list and a later edit must not silently change who was told.
  mentions      String[] @default([])
  /// True when the message said `@here`.
  mentionedHere Boolean  @default(false)

  /// `{ "👍": ["userId", …] }` — §3's reactions. Json because it is read whole with the message.
  reactions Json @default("{}")

  /// The records this message referred to, as `[{ entityType, entityId, label }]`. Resolved once at
  /// post time so the card renders without every reader re-parsing the body.
  links Json @default("[]")

  editedAt  DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  deletedBy String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// The channel read, newest last.
  @@index([channelId, createdAt])
  @@index([threadRootId])
}

/// §4's manual calendar entry.
///
/// Only the manual ones are stored. Everything else on the calendar — tickets, mobilisations,
/// deliveries, PM visits, quotation expiries, invoice due dates, liquidation deadlines, calibration
/// dates, leave — is **derived from the record that owns it** and never copied here. A second copy
/// of a due date is a second thing to keep in step, and the one on the calendar is the one nobody
/// updates.
model CalendarEvent {
  id          String  @id @default(cuid())
  title       String
  description String?
  location    String?

  startsAt DateTime
  /// Null for a point in time, like a reminder.
  endsAt   DateTime?
  allDay   Boolean   @default(false)

  ownerId     String
  attendeeIds String[] @default([])

  /// Optional link to whatever the meeting is about, as everywhere else in this module.
  entityType String?
  entityId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([startsAt])
  @@index([ownerId, startsAt])
}

/// §4's per-user iCal feed token: *"token-authenticated, so it can appear in their phone calendar"*.
///
/// Its own row rather than a column on `User` because it is a credential with a life of its own —
/// it can be rotated without touching the account, and a rotation must invalidate the old URL
/// immediately. `lastUsedAt` is what makes an unused feed safe to revoke.
model CalendarFeedToken {
  id     String @id @default(cuid())
  userId String @unique
  /// 32 random bytes, hex. Long enough that guessing is not a route in.
  token  String @unique

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

/// §5's announcement — ISO 9001 clause 7.4 communication evidence.
///
/// The point is not the notice; it is the **acknowledgement list**. A policy change nobody can prove
/// was read is a policy change that did not happen, and the first time a procedure is revised is the
/// first time somebody asks who has seen it.
model Announcement {
  id    String @id @default(cuid())
  title String
  body  String

  /// Empty means the whole company. Otherwise the roles it is addressed to.
  audienceRoleKeys String[] @default([])

  /// Whether people must tick that they have read it. Off for "the office is closed on Friday";
  /// on for anything the company would ever need to prove.
  requiresAck Boolean @default(false)

  /// low | normal | urgent. Urgent passes §7's quiet hours.
  priority String @default("normal")

  publishedAt   DateTime  @default(now())
  publishedById String
  /// After this it stops appearing as current. Never deleted: the evidence outlives the notice.
  expiresAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  acknowledgements AnnouncementAck[]

  @@index([publishedAt])
}

/// Who has read it, and when. The row exists only once somebody has acknowledged — an absent row is
/// the evidence that they have not.
model AnnouncementAck {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  acknowledgedAt DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}
