// Identity, access, and Auth.js persistence (specs/00-foundation.md §4). Owned by module 00.

model User {
  id                 String  @id @default(cuid())
  email              String  @unique
  name               String
  phone              String?
  jobTitle           String?
  passwordHash       String
  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(false)
  // Seeded demo accounts (one per unassigned role) are flagged so they're excluded from
  // production data exports and easy to spot in the admin UI (specs/00-foundation.md §4.3).
  isDemoUser         Boolean @default(false)

  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  totpEnrolledAt DateTime?

  // Login throttling (specs/00-foundation.md §4.1): 5 failures -> 15 minute lockout.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  // Spec.md §10's cross-cutting rule is "soft-delete with deletedAt + deletedBy". Not a relation
  // to User: the deleting admin can themselves be deleted later, and a foreign key would either
  // block that or cascade away the evidence of who did what.
  deletedBy String?

  roles               UserRole[]
  permissionOverrides UserPermissionOverride[]
  accounts            Account[]
  sessions            Session[]
  recoveryCodes       RecoveryCode[]

  @@index([email])
}

/// One single-use way back in when the authenticator is gone.
///
/// specs/00-foundation.md §4.1 makes TOTP mandatory — "no opt-out, no admin-only carve-out" — and
/// this build honoured that so completely that a lost phone meant a permanent lockout with no path
/// back except an operator running `npm run reset:credentials` against the database. With five
/// users and one of them the president, that was the wrong trade.
///
/// **Recovery codes are not an opt-out.** Redeeming one signs you in *and* revokes the enrolment,
/// so the next thing you do is enrol an authenticator again. The factor is restored, not skipped.
///
/// **And deliberately not an admin reset**, which is the other obvious fix: letting a signed-in
/// president clear somebody's second factor would mean one compromised officer account could take
/// over every other account without knowing a single password — a privilege-escalation path
/// straight through the control §4.1 calls non-negotiable. See scripts/reset-user-credentials.ts,
/// which has said so since session 2.
model RecoveryCode {
  id     String @id @default(cuid())
  userId String

  /// argon2, exactly like a password. A recovery code *is* a credential, and a database leak that
  /// hands over the second factor in plaintext defeats the point of having one.
  codeHash String

  /// Single use. Kept rather than deleted so "which code was used, and when" stays answerable —
  /// a redeemed code is evidence about a real event.
  usedAt DateTime?
  usedIp String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Role {
  id       String  @id @default(cuid())
  key      String  @unique
  name     String
  isSystem Boolean @default(true)

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  label String
  group String

  roles     RolePermission[]
  overrides UserPermissionOverride[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// Grants or revokes one permission for one user, layered on top of their roles' permissions
// (specs/00-foundation.md §4.2: "union of role permissions, then apply per-user overrides").
model UserPermissionOverride {
  userId       String
  permissionId String
  granted      Boolean

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

// Auth.js v5 Prisma adapter models. Account exists for a future optional Google Workspace OIDC
// provider (specs/00-foundation.md §4.1) — the credentials provider doesn't use it.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Database-backed sessions (specs/00-foundation.md §4.1): 12h idle timeout enforced by Auth.js
// `updateAge`, 30-day absolute lifetime enforced by `maxAge`. ip/userAgent captured at sign-in so
// the "full session list per user with device/IP and revoke-all" requirement has something to show.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// The automatic approval fallback (Spec.md §4.4). One row per approval type; the escalation
// eligibility logic itself lives in src/server/core/rbac/approval-fallback.ts and is pure/
// stateless — this table only holds the configured windows. Consumed by the generic approvals
// service built in module 00 session 4.
model ApprovalRule {
  id                   String   @id @default(cuid())
  key                  String   @unique
  label                String
  primaryApproverRole  String
  fallbackApproverRole String
  escalateAfterHours   Int
  escalationMode       String   @default("parallel")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
