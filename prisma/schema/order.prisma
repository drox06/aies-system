// Module 03 — Customer PO, Sales Order, Procurement and Delivery (specs/03-order-procurement.md §2).
//
// §1 names what this module is: "the pivot point… where the deal stops being a sales artifact and
// becomes an obligation." `CustomerPO` was pulled forward during module 02 for the pipeline's
// Received PO column; the rest arrives here.
//
// **The one structural instruction §1 gives, and the reason most of these columns exist:** model a
// sales order as *independent workstreams*, not a linear status chain — "a single status field
// cannot represent 'goods received, downpayment still unpaid, installation scheduled'." So
// `SalesOrder` carries four status columns that move independently, and the overall `status` is a
// summary of them rather than the thing they derive from.

model CustomerPO {
  id String @id @default(cuid())

  accountId   String
  // §2 makes this optional because a PO can arrive against no quotation at all — a repeat order on
  // agreed prices. The pipeline flow always has one.
  quotationId String?
  // Not in §2's list. The pipeline is an *inquiry* board, and without this the card the PO belongs
  // to could only be found by walking back through the quotation. Module 03 keeps it: its own
  // §1 fan-out (finance, procurement, operations) all trace back to the inquiry that started it.
  inquiryId   String?

  // The customer's own number, as printed on their document. Not unique: two customers may each
  // have a PO-0001, and a customer may re-issue a corrected PO under the same number.
  poNumber String
  poDate   DateTime

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("PHP")

  // §2: "scanned PO is mandatory". Enforced as a non-null column rather than by validation alone —
  // a PO record with no document behind it is an assertion, and the whole point of this row is that
  // somebody has the paper.
  fileId String

  receivedById String
  receivedAt   DateTime @default(now())

  // received | verified | discrepancy | cancelled (§2).
  //
  // Only `received` is reachable today. Verification against the quotation is module 03's work, and
  // `discrepancy` is meaningless until something does that comparison — leaving the column with its
  // full vocabulary is what lets module 03 add the check without a migration.
  status String @default("received")

  discrepancyNotes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  account    CustomerAccount @relation(fields: [accountId], references: [id])
  quotation  Quotation?      @relation(fields: [quotationId], references: [id])
  inquiry    Inquiry?        @relation(fields: [inquiryId], references: [id])
  salesOrder SalesOrder?
  tickets    Ticket[]

  @@index([accountId, receivedAt])
  @@index([quotationId])
  @@index([inquiryId])
}

/// The people AIES buys from (§2).
///
/// §2 is unusually specific about how this gets populated, and it shapes the whole model:
/// "Confirmed: this directory is maintained by users, not by any integration. Make the create/edit
/// form fast and forgiving — it is the only way suppliers get in." So `name` is the only required
/// field beyond the generated code. Everything else can follow.
///
/// **This is the model two earlier modules were waiting for.** `PrincipalProspect.supplierId` and
/// `SupplierQuoteRequest.supplierId` have been plain id columns since sessions 3 and 4, documented
/// as "a foreign key on the day module 03 lands". Today is that day — see the relations below.
///
/// `isApproved` is ISO 9001 clause 8.4's approved-supplier control, which docs/PROGRESS.md has
/// listed as owed since module 01: the company asked to know both "can we legally sell to this
/// customer" (§5b accreditation, built) and "is this vendor approved to buy from" (this).
model Supplier {
  id   String @id @default(cuid())
  /// SUP-{####} from the numbering service. Permanent, like an account code — no year segment,
  /// because a supplier relationship is not a dated document.
  code String @unique
  name String

  /// True when this supplier is a manufacturer AIES represents, rather than a trading source.
  /// §5c's appointment sets it; it is what separates "we sell their equipment" from "we buy bar
  /// stock here".
  isPrincipal Boolean @default(false)

  country  String?
  currency String  @default("PHP")

  contactName String?
  email       String?
  phone       String?
  /// Json for the same reason as CustomerAccount.billingAddress: Philippine addresses do not
  /// decompose cleanly, and every consumer wants the whole block.
  address     Json    @default("{}")

  paymentTerms        String?
  leadTimeDaysTypical Int?
  incoterm            String?
  /// The brands this supplier represents. Array rather than a join table — read whole, never
  /// queried across.
  productLines        String[] @default([])

  /// ISO 9001 clause 8.4 supplier control. `approvalExpiry` gets the same renewal ladder §5c's
  /// distributor agreements have, for the same reason: an approval that lapses unnoticed means
  /// buying from an unapproved vendor and finding out at the audit.
  rating         Int?
  isApproved     Boolean   @default(false)
  approvedAt     DateTime?
  approvalExpiry DateTime?

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  /// The §5c prospect this supplier was converted from, when it came that way. Nullable because a
  /// supplier can equally be typed in directly — most are not principals.
  principalProspect PrincipalProspect?

  /// The §3 price requests put to this supplier.
  ///
  /// This relation was deliberately absent for one commit. `SupplierQuoteRequest.supplierId` held
  /// `PrincipalProspect` ids — appointed principals were the interim answer to "who do we ask" —
  /// so declaring it emitted a foreign key that could not hold against live rows. It exists now
  /// because `scripts/backfill-suppliers-from-principals.ts` converted the appointed prospects and
  /// repointed the RFQs first.
  supplierQuoteRequests SupplierQuoteRequest[]

  /// The orders actually placed with this supplier (§5). This is the relation that makes
  /// `isApproved` mean something: recording what an unapproved vendor quoted is fine, buying from
  /// one is what clause 8.4 governs.
  supplierPOs SupplierPO[]

  @@index([isPrincipal, deletedAt])
  @@index([name])
}

/// What AIES buys, from whom, against which sales order (§5).
///
/// §5's shape in one line: "Created from a sales order: select lines → group by supplier → generate
/// draft POs." One supplier per PO, several POs per sales order — because a single order routinely
/// sources the meter from Germany, the valves locally and the freight from a forwarder, and each of
/// those is a separate commitment with its own lead time, currency and approval.
///
/// **The landed-cost columns are not decoration.** §5: "freight, duties, brokerage, and bank charges
/// are captured on the PO header and allocated across lines by value or by weight… Without this,
/// reported margin is fiction on imported goods." They live on the header because that is how they
/// are invoiced — one freight bill for a shipment, not a freight line per item.
model SupplierPO {
  id     String @id @default(cuid())
  /// PO-{YY}-{#####}, seeded in prisma/seed.ts since module 00.
  number String @unique

  supplierId   String
  /// Nullable per §2. Most POs answer a sales order; a stock replenishment answers none, and
  /// module 04's `material.purchase_required` will raise POs that belong to a job rather than a sale.
  salesOrderId String?

  poDate   DateTime @default(now())
  currency String   @default("PHP")
  /// The rate used to convert this PO into PHP for margin reporting. Stored on the document rather
  /// than looked up later: the margin was decided at this rate, and a rate that moves afterwards
  /// must not silently rewrite what the deal was worth. Same rule as `Quotation.fxBufferPct`.
  fxRate   Decimal  @default(1) @db.Decimal(14, 6)

  subtotal     Decimal @default(0) @db.Decimal(14, 2)
  freight      Decimal @default(0) @db.Decimal(14, 2)
  duties       Decimal @default(0) @db.Decimal(14, 2)
  otherCharges Decimal @default(0) @db.Decimal(14, 2)
  total        Decimal @default(0) @db.Decimal(14, 2)

  /// draft | pending_approval | approved | sent | acknowledged | partially_received | received |
  /// cancelled (§2). `partially_received` and `received` are moved by session 3's goods receipt;
  /// everything up to `acknowledged` is this session's.
  status String @default("draft")

  expectedShipDate    DateTime?
  expectedArrivalDate DateTime?

  incoterm     String?
  /// air | sea | land | courier
  shipmentMode String?
  trackingRef  String?
  /// The supplier's own order number, as they refer to it. Every follow-up call quotes theirs, not
  /// ours, and without this the call starts by asking them to look it up.
  supplierRef  String?

  approvedById   String?
  approvedAt     DateTime?
  sentAt         DateTime?
  /// §5: "Track supplier acknowledgement by hand. No automated supplier email in v1."
  acknowledgedAt DateTime?

  /// §4's gate, and the fact that somebody overrode it. Stored on the PO because the question asked
  /// at an audit is about *this order* — "why was this placed before the customer paid" — and an
  /// audit-log-only record makes that a search rather than a glance.
  downpaymentOverrideById          String?
  downpaymentOverrideAt            DateTime?
  downpaymentOverrideReason        String?
  /// The same, for buying from a supplier that clause 8.4 has not approved.
  unapprovedSupplierOverrideBy     String?
  unapprovedSupplierOverrideReason String?

  notes String?

  version Int @default(0)

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  supplier   Supplier         @relation(fields: [supplierId], references: [id])
  salesOrder SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  lines      SupplierPOLine[]
  receipts   GoodsReceipt[]

  @@index([supplierId, status])
  @@index([salesOrderId])
  @@index([status, expectedArrivalDate])
}

/// A line of a supplier order (§2).
///
/// `salesOrderLineId` is what makes the expediting view answerable: §5 wants "all open supplier POs
/// with expected arrival, days late, **and the customer commitment they support**". Without the link
/// back, procurement can say a shipment is late and nobody can say whose delivery it delays.
model SupplierPOLine {
  id           String @id @default(cuid())
  supplierPOId String
  lineNo       Int

  salesOrderLineId String?

  productId    String?
  description  String
  manufacturer String?
  modelNumber  String?

  quantity  Decimal @default(1) @db.Decimal(14, 3)
  unit      String  @default("pc")
  unitCost  Decimal @default(0) @db.Decimal(14, 2)
  /// quantity × unitCost, before the header charges. The allocated landed cost is derived at read
  /// time rather than stored, so changing the freight on the header cannot leave stale line values
  /// behind — see `allocateLandedCost` in supplier-po-rules.ts.
  lineTotal Decimal @default(0) @db.Decimal(14, 2)

  qtyReceived  Decimal @default(0) @db.Decimal(14, 3)
  leadTimeDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierPO SupplierPO         @relation(fields: [supplierPOId], references: [id], onDelete: Cascade)
  receipts   GoodsReceiptLine[]

  @@unique([supplierPOId, lineNo])
  @@index([salesOrderLineId])
}

/// Goods arriving against a supplier PO (§6).
///
/// §6's first sentence is a requirement, not a description: "**Incoming inspection is required**
/// (ISO 9001 clause 8.4.2, verification of externally provided processes/products): quantity check,
/// damage check, documentation check (test certificates, calibration certificates, datasheets,
/// warranty), and photos."
///
/// So the four checks are columns rather than a free-text note, and `status` cannot reach `accepted`
/// without them. A receipt that could be accepted unchecked would let unverified goods into stock,
/// which is precisely what the clause exists to prevent — and "we always check" is not evidence an
/// auditor accepts.
///
/// **Partial receipts are the normal case**, not the exception: a PO for five meters routinely
/// arrives as three and then two. So a supplier PO has many receipts, and the running totals live on
/// the lines rather than being inferred from the newest one.
model GoodsReceipt {
  id     String @id @default(cuid())
  /// GRN-{YY}-{#####} from the numbering service.
  number String @unique

  supplierPOId String

  receivedAt   DateTime @default(now())
  receivedById String

  /// draft | inspected | accepted | partially_rejected | rejected (§2).
  ///
  /// `draft` is what somebody is filling in while the boxes are still on the floor. Everything from
  /// `inspected` onward has passed the clause 8.4.2 checks below.
  status String @default("draft")

  /// §6's paperwork trail. Nullable because a delivery genuinely arrives without a waybill
  /// sometimes, and a required field somebody has to invent a value for is a field that gets
  /// invented values.
  packingListRef String?
  invoiceRef     String?
  waybillRef     String?

  /// §6's four checks, ISO 9001 clause 8.4.2.
  ///
  /// Separate booleans rather than one "inspected" flag, because they fail independently and for
  /// different reasons: the count can be right while the calibration certificate is missing, and
  /// those are two different conversations with the supplier.
  quantityChecked      Boolean @default(false)
  damageChecked        Boolean @default(false)
  documentationChecked Boolean @default(false)
  /// Whether at least one photograph was attached. Derived from the stored files at inspection time
  /// and frozen here, so a photo deleted later cannot retroactively invalidate a passed inspection.
  photosAttached       Boolean @default(false)

  inspectionNotes String?
  inspectedById   String?
  inspectedAt     DateTime?

  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  supplierPO SupplierPO         @relation(fields: [supplierPOId], references: [id])
  lines      GoodsReceiptLine[]

  @@index([supplierPOId, receivedAt])
  @@index([status])
}

/// What actually arrived, per line (§2).
///
/// The three quantities are not redundant: `qtyReceived` is what came off the truck, and it splits
/// into `qtyAccepted` and `qtyRejected`. Only the accepted part advances the sales order's
/// fulfilment — §11 requires that "partial receipt then partial delivery keeps
/// qtyOrdered/Received/Delivered consistent", and counting rejected goods as received would make a
/// customer's order look fulfilled by a box that is going back to the supplier.
model GoodsReceiptLine {
  id               String @id @default(cuid())
  goodsReceiptId   String
  /// Which line of the supplier PO this fulfils. Not nullable: goods that answer no order line are
  /// goods nobody bought, and recording them here would hide a real problem.
  supplierPOLineId String

  qtyReceived     Decimal @default(0) @db.Decimal(14, 3)
  qtyAccepted     Decimal @default(0) @db.Decimal(14, 3)
  qtyRejected     Decimal @default(0) @db.Decimal(14, 3)
  /// Required when anything is rejected. §6 sends rejections to module 08 as an NCR; module 08 does
  /// not exist, so the reason is recorded here and the NCR is raised from it when it does — rather
  /// than inventing an NCR model now for module 08 to reconcile.
  rejectionReason String?

  /// §6: "Serial numbers captured per unit where applicable — these become the installed-equipment
  /// register in module 04 and drive after-sales support."
  serialNumbers         String[] @default([])
  batchNo               String?
  /// §6 files calibration and test certificates as controlled documents in module 07 "linked to the
  /// serial number, so they can be re-issued to the customer years later". Module 07 does not exist;
  /// the upload is a plain `FileObject` id today and becomes a controlled-document reference then.
  calibrationCertFileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goodsReceipt   GoodsReceipt   @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  supplierPOLine SupplierPOLine @relation(fields: [supplierPOLineId], references: [id])

  @@unique([goodsReceiptId, supplierPOLineId])
  @@index([supplierPOLineId])
}

/// The obligation (§2), and the module's centre of gravity.
///
/// §1: "Model this as a sales order with **independent workstreams**, not a linear status chain. A
/// single status field cannot represent 'goods received, downpayment still unpaid, installation
/// scheduled.'" That instruction is why there are four status columns here instead of one, and it
/// is the single most load-bearing decision in this module — a linear chain would have forced every
/// screen to lie about at least one of the three fan-outs §1 describes.
model SalesOrder {
  id     String @id @default(cuid())
  /// SO-{YY}-{#####}, the format Spec.md §5 lists and prisma/seed.ts already seeds.
  number String @unique

  accountId    String
  siteId       String?
  quotationId  String
  /// One sales order per customer PO. The unique constraint is the guard: raising a second order
  /// against the same PO is double-committing to the same money, and it is the kind of mistake that
  /// only shows up when the customer is invoiced twice.
  customerPOId String  @unique

  orderDate      DateTime  @default(now())
  requiredByDate DateTime?

  currency     String  @default("PHP")
  subtotal     Decimal @default(0) @db.Decimal(14, 2)
  vatAmount    Decimal @default(0) @db.Decimal(14, 2)
  total        Decimal @default(0) @db.Decimal(14, 2)
  /// Permission-gated on the way out, exactly as on the quotation (Spec.md §4.3).
  totalCost    Decimal @default(0) @db.Decimal(14, 2)
  marginAmount Decimal @default(0) @db.Decimal(14, 2)

  /// Plain id: `PaymentTerm` is module 05's and does not exist yet. Same deferral the quotation
  /// makes, so module 05 fills both in rather than reconciling two mechanisms.
  paymentTermsId    String?
  downpaymentPct    Decimal @default(0) @db.Decimal(7, 4)
  downpaymentAmount Decimal @default(0) @db.Decimal(14, 2)

  /// open | in_progress | partially_delivered | delivered | in_execution | completed | closed |
  /// cancelled. A **summary** of the three workstreams below, never their source.
  status String @default("open")

  /// The three independent workstreams §1 insists on. Each moves on its own evidence: procurement
  /// on supplier POs and goods receipts, finance on module 05's payments, execution on module 04's
  /// tickets. None of them waits for the others.
  procurementStatus String @default("not_required")
  financeStatus     String @default("awaiting_downpayment")
  executionStatus   String @default("not_required")

  ownerId          String
  projectManagerId String?

  closedAt DateTime?
  /// Spec.md §10 requires optimistic locking on the records two people edit at once. A sales order
  /// is worked by sales, procurement and operations simultaneously by design.
  version  Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  account          CustomerAccount   @relation(fields: [accountId], references: [id])
  site             Site?             @relation(fields: [siteId], references: [id])
  quotation        Quotation         @relation(fields: [quotationId], references: [id])
  customerPO       CustomerPO        @relation(fields: [customerPOId], references: [id])
  lines            SalesOrderLine[]
  supplierPOs      SupplierPO[]
  tickets          Ticket[]
  deliveryReceipts DeliveryReceipt[]

  @@index([accountId, status])
  @@index([ownerId, status])
  @@index([status, orderDate])
}

/// A line of the obligation, carrying its own fulfilment counters (§2).
///
/// The three counters are what make partial fulfilment representable: §11 asks for "partial receipt
/// then partial delivery keeps qtyOrdered/Received/Delivered consistent; over-receipt and
/// over-delivery are rejected". They are stored rather than derived because they are summed from
/// records in three different modules, and a derived value would mean every screen re-deriving it.
/// The delivery receipt (specs/03-order-procurement.md §7).
///
/// §7 draws the boundary and it is worth restating: **this module owns the document**, module 04 §13
/// owns the execution lane. This is generated, numbered, signed and stored here; what happened when
/// somebody tried to deliver against it lives in `DeliveryTicketFlow`.
///
/// A DR is never issued without a delivery ticket to execute it — §7 calls the flowchart's `DR REQ`
/// box "a real gate" that stops DRs floating around unassigned, so `ticketId` is required.
model DeliveryReceipt {
  id     String @id @default(cuid())
  /// AIESDR-{YY}{####}.
  number String @unique

  salesOrderId String
  /// The module 04 delivery ticket that asked for this. Required — §7's gate.
  ticketId     String
  accountId    String
  siteId       String?

  /// draft | issued | delivered | acknowledged | cancelled.
  ///
  /// §7: the DR is held at `delivered` rather than `acknowledged` until the signature arrives, and
  /// billing that depends on a signed DR stays gated until then. That gap is the billing risk module
  /// 04 §13 calls `delivered_unsigned`.
  status String @default("draft")

  issuedAt    DateTime?
  issuedById  String?
  deliveredAt DateTime?

  /// §7's mobile capture at site. The signature is what turns `delivered` into `acknowledged` — a
  /// courier's proof of delivery explicitly does not (§13.2 step 5).
  recipientName     String?
  recipientPosition String?
  signatureFileId   String?
  signedAt          DateTime?
  photoFileIds      String[]  @default([])

  remarks String?

  version Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  salesOrder SalesOrder            @relation(fields: [salesOrderId], references: [id])
  lines      DeliveryReceiptLine[]

  @@index([salesOrderId, status])
  @@index([ticketId])
  @@index([status, deliveredAt])
}

/// What is on the DR. §7 supports partial deliveries, each generating its own DR.
model DeliveryReceiptLine {
  id                String @id @default(cuid())
  deliveryReceiptId String
  salesOrderLineId  String
  lineNo            Int

  description String
  quantity    Decimal @default(1) @db.Decimal(14, 3)
  unit        String  @default("pc")

  createdAt DateTime @default(now())

  receipt DeliveryReceipt @relation(fields: [deliveryReceiptId], references: [id], onDelete: Cascade)

  @@unique([deliveryReceiptId, lineNo])
  @@index([salesOrderLineId])
}

model SalesOrderLine {
  id           String @id @default(cuid())
  salesOrderId String
  lineNo       Int

  /// The quotation line this came from — the answer to "what did we actually promise?" once the
  /// quotation has been superseded by a later revision.
  quotationLineId String?

  itemType    String  @default("product")
  productId   String?
  description String
  quantity    Decimal @default(1) @db.Decimal(14, 3)
  unit        String  @default("pc")

  unitPrice Decimal @default(0) @db.Decimal(14, 2)
  lineTotal Decimal @default(0) @db.Decimal(14, 2)
  unitCost  Decimal @default(0) @db.Decimal(14, 2)

  qtyOrdered   Decimal @default(0) @db.Decimal(14, 3)
  qtyReceived  Decimal @default(0) @db.Decimal(14, 3)
  qtyDelivered Decimal @default(0) @db.Decimal(14, 3)

  /// §3: service and labour lines, and products flagged as needing installation. If any line on the
  /// order sets this, `executionStatus` starts at `pending` and module 04 is signalled — so this
  /// flag is what decides whether a sale is also a job.
  requiresExecution Boolean @default(false)

  /// pending | ordered | received | delivered | executed | cancelled
  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@unique([salesOrderId, lineNo])
  @@index([salesOrderId])
}
